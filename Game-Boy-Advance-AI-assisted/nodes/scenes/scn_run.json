    },
    {
      "do": "add_var",
      "var": "items_total",
      "from": "power_ups"
    },
    {
      "do": "add_var",
      "var": "items_total",
      "from": "plots_used"
    },
    {
      "do": "if_var",
      "var": "plots_used",
      "op": "<",
      "value": 4,
      "then": [
        {
          "do": "if_var",
          "var": "items_total",
          "op": "<",
          "value": 10,
          "then": [
            {
              "do": "spawn",
              "object": "item_seed",
              "x": 44,
              "y": 52,
              "relative": false
            }
          ]
        }
      ]
    },
    {
      "do": "fade_in",
      "ticks": 20
    },
    {
      "do": "set_var",
