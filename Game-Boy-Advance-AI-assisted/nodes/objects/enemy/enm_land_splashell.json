{
  "id": "enm_land_splashell",
  "kind": "object",
  "type": "enemy",
  "name": "Splashell guard (Coral Lagoon)",
  "notes": "A guard of the Coral Lagoon's challenge screen (C1, The Reef): a level 5 Splashell with 110 HP, at most 2 of them come at you at once, attacking every 5.0 s with its first move. They never leave their screen, give no XP and drop nothing; leaving the screen before they are all down brings every one back at full HP. Only there while Sproutle is still trapped (appear_if unlocked == 4, per place). When the last of the 5 faints (kills, reset on every screen), Sproutle is unlocked and saved at once, then the world freezes a moment, it appears with a sparkle and its cry, the new-monster jingle plays and the middle of the screen says SPROUTLE UNLOCKED! / PICK IT IN THE CAVE.",
  "logic": [
    {
      "behavior": "appear_if",
      "params": {
        "var": "unlocked",
        "op": "==",
        "value": 4
      }
    },
    {
      "behavior": "monster",
      "params": {
        "species": "mon_splashell",
        "level": 5,
        "hp": 110,
        "flash_palette": "pal_flash_red",
        "flash_ticks": 4,
        "flashes": 3,
        "level_tag": 180,
        "level_tag_reset": 300,
        "level_tag_margin": 32,
        "level_tag_text": "LV",
        "level_tag_palette": "pal_txt_cyan",
        "level_tag_matchup": true,
        "alert_text": "!",
        "alert_palette": "pal_txt_yellow",
        "alert_cry": true,
        "xp_reward": 0,
        "kills_var": "kills",
        "on_death": [
          {
            "do": "if_var",
            "var": "kills",
            "op": ">=",
            "value": 5,
            "then": [
              {
                "do": "set_var",
                "var": "unlocked",
                "value": 5
              },
              {
                "do": "set_var",
                "var": "new_mon",
                "value": 4
              },
              {
                "do": "save_game"
              },
              {
                "do": "play_music",
                "music": "mus_menu"
              },
              {
                "do": "pause_world",
                "ticks": 40
              },
              {
                "do": "spawn",
                "object": "ptc_freed",
                "x": 600,
                "y": 134,
                "relative": false
              },
              {
                "do": "spawn",
                "object": "prop_freed_sproutle",
                "x": 600,
                "y": 142,
                "relative": false
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_cry_sproutle"
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 1
              },
              {
                "do": "wait",
                "ticks": 30
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_new_move"
              },
              {
                "do": "wait",
                "ticks": 210
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "behavior": "monster_ai",
      "params": {
        "speed": 1.0,
        "chase_speed": 1.0,
        "roam": 4,
        "sight": 5,
        "give_up": 10,
        "max_hostile": 2,
        "charge": 300,
        "moves": 1,
        "moves_charge": 100,
        "moves_ready": false,
        "spread": 1
      }
    }
  ]
}
