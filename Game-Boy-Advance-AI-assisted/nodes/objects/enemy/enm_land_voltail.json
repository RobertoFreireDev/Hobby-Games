{
  "id": "enm_land_voltail",
  "kind": "object",
  "type": "enemy",
  "name": "Voltail guard (Storm Plateau)",
  "notes": "A guard of the Storm Plateau's challenge screen (A1, High Mesas): a level 3 Voltail with 20 HP, at most 1 of them come at you at once, attacking every 8.0 s with its first move. They never leave their screen, give no XP and drop nothing; leaving the screen before they are all down brings every one back at full HP. Only there while Venomole is still trapped (appear_if unlocked == 5, per place). When the last of the 4 faints (kills, reset on every screen), Venomole is unlocked and saved at once, then the world freezes a moment, it appears with a sparkle and its cry, the new-monster jingle plays and the middle of the screen says VENOMOLE UNLOCKED! / PICK IT IN THE CAVE.",
  "logic": [
    {
      "behavior": "appear_if",
      "params": {
        "var": "unlocked",
        "op": "==",
        "value": 5
      }
    },
    {
      "behavior": "monster",
      "params": {
        "species": "mon_voltail",
        "level": 3,
        "hp": 20,
        "flash_palette": "pal_flash_red",
        "flash_ticks": 4,
        "flashes": 3,
        "level_tag": 180,
        "level_tag_reset": 300,
        "level_tag_margin": 32,
        "level_tag_text": "LV",
        "level_tag_palette": "pal_txt_cyan",
        "level_tag_matchup": true,
        "alert_text": "!",
        "alert_palette": "pal_txt_yellow",
        "alert_cry": true,
        "xp_reward": 0,
        "kills_var": "kills",
        "on_death": [
          {
            "do": "if_var",
            "var": "kills",
            "op": ">=",
            "value": 4,
            "then": [
              {
                "do": "set_var",
                "var": "unlocked",
                "value": 6
              },
              {
                "do": "set_var",
                "var": "new_mon",
                "value": 5
              },
              {
                "do": "save_game"
              },
              {
                "do": "play_music",
                "music": "mus_menu"
              },
              {
                "do": "pause_world",
                "ticks": 40
              },
              {
                "do": "spawn",
                "object": "ptc_freed",
                "x": 120,
                "y": 52,
                "relative": false
              },
              {
                "do": "spawn",
                "object": "prop_freed_venomole",
                "x": 120,
                "y": 60,
                "relative": false
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_cry_venomole"
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 1
              },
              {
                "do": "wait",
                "ticks": 30
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_new_move"
              },
              {
                "do": "wait",
                "ticks": 210
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "behavior": "monster_ai",
      "params": {
        "speed": 0.7,
        "chase_speed": 1.0,
        "roam": 8,
        "sight": 5,
        "give_up": 10,
        "max_hostile": 1,
        "charge": 480,
        "moves": 1,
        "moves_charge": 100,
        "moves_ready": false,
        "spread": 1
      }
    }
  ]
}
