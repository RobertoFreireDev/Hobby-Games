{
  "id": "enm_land_pebbulk",
  "kind": "object",
  "type": "enemy",
  "name": "Pebbulk guard (Boulder Canyon)",
  "notes": "A guard of the Boulder Canyon's challenge screen (A5, Pebbulk Quarry): a level 8 Pebbulk with 100 HP, at most 2 of them come at you at once, attacking every 4.0 s with its first move (and Harden every 12 s). They never leave their screen, give no XP and drop nothing; leaving the screen before they are all down brings every one back at full HP. Only there while Emberpup is still trapped (appear_if unlocked == 1, per place). When the last of the 4 faints (kills, reset on every screen), Emberpup is unlocked and saved at once, then the world freezes a moment, it appears with a sparkle and its cry, the new-monster jingle plays and the middle of the screen says EMBERPUP UNLOCKED! / PICK IT IN THE CAVE.",
  "logic": [
    {
      "behavior": "appear_if",
      "params": {
        "var": "unlocked",
        "op": "==",
        "value": 1
      }
    },
    {
      "behavior": "monster",
      "params": {
        "species": "mon_pebbulk",
        "level": 8,
        "hp": 100,
        "flash_palette": "pal_flash_red",
        "flash_ticks": 4,
        "flashes": 3,
        "level_tag": 180,
        "level_tag_reset": 300,
        "level_tag_margin": 32,
        "level_tag_text": "LV",
        "level_tag_palette": "pal_txt_cyan",
        "level_tag_matchup": true,
        "alert_text": "!",
        "alert_palette": "pal_txt_yellow",
        "alert_cry": true,
        "xp_reward": 0,
        "kills_var": "kills",
        "on_death": [
          {
            "do": "if_var",
            "var": "kills",
            "op": ">=",
            "value": 4,
            "then": [
              {
                "do": "set_var",
                "var": "unlocked",
                "value": 2
              },
              {
                "do": "set_var",
                "var": "new_mon",
                "value": 1
              },
              {
                "do": "save_game"
              },
              {
                "do": "play_music",
                "music": "mus_menu"
              },
              {
                "do": "pause_world",
                "ticks": 40
              },
              {
                "do": "spawn",
                "object": "ptc_freed",
                "x": 120,
                "y": 724,
                "relative": false
              },
              {
                "do": "spawn",
                "object": "prop_freed_emberpup",
                "x": 120,
                "y": 732,
                "relative": false
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_cry_emberpup"
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 1
              },
              {
                "do": "wait",
                "ticks": 30
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_new_move"
              },
              {
                "do": "wait",
                "ticks": 210
              },
              {
                "do": "set_var",
                "var": "banner",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "behavior": "monster_ai",
      "params": {
        "speed": 0.5,
        "chase_speed": 0.75,
        "roam": 32,
        "sight": 5,
        "give_up": 10,
        "max_hostile": 2,
        "charge": 240,
        "moves": 2,
        "moves_charge": 200,
        "moves_ready": false,
        "spread": 1
      }
    }
  ]
}
