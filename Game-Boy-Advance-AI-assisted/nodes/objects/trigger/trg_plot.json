{
  "id": "trg_plot",
  "kind": "object",
  "type": "trigger",
  "name": "Garden plot zone",
  "notes": "The middle of a garden plot (12 x 16 px over its soil). When the monster walks onto it and the plot holds a ripe item, the item is picked up: HP UP adds 1 to hp_ups (6 = ripe HP UP), POWER UP adds 1 to power_ups (7), the plot becomes empty soil (0), a chime plays (sfx_item) and it is saved at once. Its message joins the menu's queue (msg_q): the bottom line of the screen shows 'HP UP! MAX HP +5 (n/5)' or 'POWER UP! POWER +2% (n/5)' (+1% for the 2nd and 4th POWER UP), n = how many the player owns now, for 3 s; items picked up one after another (up to 4) show their messages in that order, 3 s each. On a plot that holds nothing ripe it does nothing. The scene gives each of the 4 zones its own plot.",
  "zone": {
    "w": 12,
    "h": 16
  },
  "logic": [
    {
      "behavior": "trigger_zone",
      "params": {
        "on_enter": [
          {
            "do": "set_var",
            "var": "item_got",
            "value": 0
          },
          {
            "do": "if_var",
            "var": "plot_1",
            "op": "==",
            "value": 6,
            "then": [
              {
                "do": "add_var",
                "var": "hp_ups",
                "value": 1
              },
              {
                "do": "set_var",
                "var": "item_got",
                "from": "hp_ups"
              }
            ]
          },
          {
            "do": "if_var",
            "var": "plot_1",
            "op": "==",
            "value": 7,
            "then": [
              {
                "do": "add_var",
                "var": "power_ups",
                "value": 1
              },
              {
                "do": "set_var",
                "var": "item_got",
                "from": "power_ups"
              },
              {
                "do": "add_var",
                "var": "item_got",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "item_got",
            "op": ">=",
            "value": 1,
            "then": [
              {
                "do": "set_var",
                "var": "plot_1",
                "value": 0
              },
              {
                "do": "play_sfx",
                "sfx": "sfx_item"
              },
              {
                "do": "save_game"
              },
              {
                "do": "set_var",
                "var": "msg_q",
                "index": "msg_n",
                "from": "item_got"
              },
              {
                "do": "add_var",
                "var": "msg_n",
                "value": 1
              },
              {
                "do": "if_var",
                "var": "msg_n",
                "op": "==",
                "value": 1,
                "then": [
                  {
                    "do": "wait",
                    "ticks": 180
                  },
                  {
                    "do": "add_var",
                    "var": "msg_i",
                    "value": 1
                  },
                  {
                    "do": "if_var",
                    "var": "msg_i",
                    "op": "<",
                    "from": "msg_n",
                    "then": [
                      {
                        "do": "wait",
                        "ticks": 180
                      },
                      {
                        "do": "add_var",
                        "var": "msg_i",
                        "value": 1
                      },
                      {
                        "do": "if_var",
                        "var": "msg_i",
                        "op": "<",
                        "from": "msg_n",
                        "then": [
                          {
                            "do": "wait",
                            "ticks": 180
                          },
                          {
                            "do": "add_var",
                            "var": "msg_i",
                            "value": 1
                          },
                          {
                            "do": "if_var",
                            "var": "msg_i",
                            "op": "<",
                            "from": "msg_n",
                            "then": [
                              {
                                "do": "wait",
                                "ticks": 180
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "do": "set_var",
                    "var": "msg_q",
                    "value": 0
                  },
                  {
                    "do": "set_var",
                    "var": "msg_n",
                    "value": 0
                  },
                  {
                    "do": "set_var",
                    "var": "msg_i",
                    "value": 0
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
