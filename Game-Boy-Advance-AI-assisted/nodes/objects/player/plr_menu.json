            "op": "==",
            "value": 1,
            "then": [
              {
                "do": "set_var",
                "var": "map_hp_max",
                "value": 132
              },
              {
                "do": "if_var",
                "var": "chosen",
                "op": "==",
                "value": 0,
                "then": [
                  {
                    "do": "set_var",
                    "var": "map_hp_max",
                    "value": 149
                  }
                ]
              }
            ]
          },
          {
            "do": "if_var",
            "var": "hp_ups",
            "op": ">=",
            "value": 1,
            "then": [
              {
                "do": "add_var",
                "var": "map_hp_max",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "hp_ups",
            "op": ">=",
            "value": 2,
            "then": [
              {
                "do": "add_var",
                "var": "map_hp_max",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "hp_ups",
            "op": ">=",
            "value": 3,
            "then": [
              {
                "do": "add_var",
                "var": "map_hp_max",
                "value": 5
              }
            ]
          },
          {
            "do": "if_var",
            "var": "hp_ups",
            "op": ">=",
            "value": 4,
            "then": [
              {
                "do": "add_var",
                "var": "map_hp_max",
                "value": 5
              }
            ]
          },
          {
