        "shadow": "spr_shadow",
        "dodge_walk": 20,
        "dodge_away": 30,
        "dodge_ticks": 6,
        "shiny_var": "shiny",
        "shiny_power": 20,
        "shiny_hp": 40,
        "shiny_flash_palette": "pal_flash_red",
        "shiny_flashes": 3,
        "low_hp_sfx": "sfx_low_hp",
        "low_hp_every": 60,
        "on_away": [
