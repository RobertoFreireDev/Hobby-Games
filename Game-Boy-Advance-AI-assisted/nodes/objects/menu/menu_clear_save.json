      "y": 48,
      "text": "EVERYTHING WILL BE LOST:"
    },
    {
      "x": 16,
      "y": 64,
      "text": "- UNLOCKED MONSTERS, PATHS"
    },
    {
      "x": 16,
      "y": 72,
