pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- rotamaze
-- by roberto freire

-- a maze that turns.
-- walk with the arrows. bump a
-- wall to aim (free). ❎ turns
-- the tile you face. 🅾️ rewinds.

bx=4 by=4 gw=15 gh=14
dx={-1,1,0,0}
dy={0,0,-1,1}
wb={8,2,1,4}
ob={2,8,4,1}
op={2,1,4,3}
-- per-tile wall colours, ordered so neighbours never look alike
tc={7,5,14,6,4,13}

function _init()
 bd={} gt={} hs={} bag={} fl={}
 st=0 tk=0 hold=0 bt=0 ft=0 rat=0
 mov=0 act=0 pc=0 pr=0 pf=1
 ec=0 er=0 ei=0
 music(0)
 menuitem(1,"new maze",newmz)
 menuitem(2,"restart",restart)
end

function ti(c,r) return r*gw+c+1 end
function onb(c,r)
 return c>=0 and c<gw and r>=0 and r<gh
end
function rotw(w) return (w*2)%16+w\8 end

-->8
-- maze / turns

function newmz()
 if #bag<1 then
  for i=0,63 do add(bag,i) end
  for i=64,2,-1 do
   local j=flr(rnd(i))+1
   bag[i],bag[j]=bag[j],bag[i]
  end
 end
 local m=bag[#bag]
 deli(bag,#bag)
 loadmz(m)
end

function loadmz(m)
 mzi=m
 local a=0x1000+m*110
 for i=0,209 do
  local b=peek(a+i\2)
  if i%2==0 then
   bd[i+1]=b&15
  else
   bd[i+1]=b\16
  end
  gt[i+1]=(i*11+m*7)%23
 end
 local s=peek(a+105)
 pc=s%gw pr=s\gw
 s=peek(a+106)
 ec=s%gw er=s\gw ei=ti(ec,er)
 pf=peek(a+107)+1
 mov=peek(a+108)
 act=peek(a+109)
 hs={} fl={}
 st=1 bt=0 ft=0 rat=0 hold=0
end

-- try to step in direction d
function trymv(d)
 local nc,nr=pc+dx[d],pr+dy[d]
 local blk=false
 fl={}
 if not onb(nc,nr) then
  blk=true
 else
  local i,j=ti(pc,pr),ti(nc,nr)
  if (bd[i]&wb[d])>0 then
   blk=true
   add(fl,{pc,pr,d})
  end
  if (bd[j]&ob[d])>0 then
   blk=true
   add(fl,{nc,nr,op[d]})
  end
 end
 if blk then
  pf=d bt=4 ft=3
  sfx(0)
  return
 end
 if mov<1 then return end
 add(hs,{0,pc,pr,pf,0,0})
 pc=nc pr=nr pf=d
 mov-=1
 sfx(1)
 if pc==ec and pr==er then
  st=2
  sfx(4)
 end
end

-- turn the faced tile
function rot()
 if act<1 or mov<1 then return end
 local nc,nr=pc+dx[pf],pr+dy[pf]
 if not onb(nc,nr) then return end
 local i=ti(nc,nr)
 add(hs,{1,pc,pr,pf,i,bd[i]})
 bd[i]=rotw(bd[i])
 act-=1 rat=5 fl={}
 sfx(2)
end

function rew()
 local n=#hs
 if n<1 then return end
 local h=hs[n]
 deli(hs,n)
 pc=h[2] pr=h[3] pf=h[4]
 if h[1]==1 then
  bd[h[5]]=h[6]
  act+=1
 else
  mov+=1
 end
 st=1 bt=0 ft=0 fl={}
 sfx(3)
end

function restart()
 while #hs>0 do rew() end
end

function _update()
 tk+=1
 if bt>0 then bt-=1 end
 if ft>0 then ft-=1 end
 if rat>0 then rat-=1 end
 if st==0 then
  -- how long the title sat there is the only entropy
  -- a cold pico-8 boot gives us for free
  if btnp(4) or btnp(5) then
   srand(tk)
   newmz()
  end
  return
 end
 if st==2 then
  -- rewind works here too: stepping back off the exit
  -- is just another undo
  if btnp(5) then
   newmz()
  elseif btnp(4) then
   rew()
  end
  return
 end
 for d=1,4 do
  if btnp(d-1) then
   trymv(d)
   break
  end
 end
 if btnp(5) then rot() end
 if btnp(4) then
  rew() hold=0
 elseif btn(4) then
  hold+=1
  if hold>25 and hold%3==0 then rew() end
 else
  hold=0
 end
end

-->8
-- draw

function _draw()
 cls()
 if st==0 then return tscr() end
 drawbd()
 hud()
 if st==2 then wscr() end
end

function drawbd()
 rect(3,3,124,116,7)
 local x,y=bx+ec*8,by+er*8
 local bl=tk%16<8
 local fc,fr=pc+dx[pf],pr+dy[pf]
 if bl then
  fillp(0x5a5a)
 else
  fillp(0xa5a5)
 end
 rectfill(x+1,y+1,x+6,y+6,7)
 fillp()
 for r=0,gh-1 do
  y=by+r*8
  for c=0,gw-1 do
   local i=ti(c,r)
   x=bx+c*8
   -- every tile draws its walls in its own colour, so a wall
   -- always says which tile it belongs to
   local k=tc[(c+r)%6+1]
   -- ...except the faced tile, which blinks its whole set of
   -- walls yellow: those are the ones ❎ is about to swing
   if bl and c==fc and r==fr then k=10 end
   local g=gt[i]
   if g<4 and i!=ei then
    pset(x+2+g%2*2,y+3+(g\2)*2,k)
   end
   local w=bd[i]
   if (w&1)>0 then line(x,y,x+7,y,k) end
   if (w&2)>0 then line(x+7,y,x+7,y+7,k) end
   if (w&4)>0 then line(x,y+7,x+7,y+7,k) end
   if (w&8)>0 then line(x,y,x,y+7,k) end
  end
 end
 if ft>0 then
  for e in all(fl) do
   x=bx+e[1]*8 y=by+e[2]*8
   local d=e[3]
   if d==1 then
    line(x+1,y+1,x+1,y+6,7)
   elseif d==2 then
    line(x+6,y+1,x+6,y+6,7)
   elseif d==3 then
    line(x+1,y+1,x+6,y+1,7)
   else
    line(x+1,y+6,x+6,y+6,7)
   end
  end
 end
 if onb(fc,fr) then
  x=bx+fc*8 y=by+fr*8
  if rat>0 then
   rect(x+1,y+1,x+6,y+6,10)
  else
   rect(x+2,y+2,x+5,y+5,10)
  end
 end
 x=bx+pc*8 y=by+pr*8
 if bt>0 then
  local o=1
  if bt>2 then o=2 end
  x+=dx[pf]*o y+=dy[pf]*o
 end
 rectfill(x+2,y+2,x+5,y+5,8)
 -- a yellow pip on the facing side, the same yellow as the
 -- marker on the tile ❎ would turn
 if pf==1 then
  line(x+2,y+3,x+2,y+4,10)
 elseif pf==2 then
  line(x+5,y+3,x+5,y+4,10)
 elseif pf==3 then
  line(x+3,y+2,x+4,y+2,10)
 else
  line(x+3,y+5,x+4,y+5,10)
 end
end

function ctr(s,y,c)
 print(s,64-print(s,0,-30)\2,y,c)
end

function cnt(l,v,x)
 local s=l.." "
 if v<10 then s=s.."0" end
 s=s..v
 if v<1 then
  rectfill(x-2,118,x+#s*4,125,7)
  print(s,x,120,0)
 else
  print(s,x,120,7)
 end
end

function hud()
 if mov<1 and st==1 then
  ctr("no moves - 🅾️ rewind",120,7)
 else
  cnt("mov",mov,6)
  cnt("act",act,98)
 end
end

function wscr()
 rectfill(28,48,99,79,0)
 rect(28,48,99,79,7)
 ctr("\^wescaped",56,7)
 ctr("❎ next maze",69,7)
end

function tscr()
 rect(3,3,124,116,7)
 fillp(0x5a5a)
 rectfill(5,5,122,10,7)
 rectfill(5,109,122,114,7)
 fillp()
 for i=0,29 do
  pset(6+(i*37)%116,16+(i*53)%92,7)
 end
 ctr("\^w\^trotamaze",26,7)
 ctr("a maze that turns",44,7)
 ctr("⬅️➡️⬆️⬇️ walk, bump to aim",62,7)
 ctr("❎ turn the faced tile",72,7)
 ctr("🅾️ rewind, hold to restart",82,7)
 if tk%32<20 then ctr("❎ begin",98,7) end
end
