pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- peg dungeon
-- by roberto freire

dx={-1,1,0,0}
dy={0,0,-1,1}
pw={1,2,3,5}
xv={1,3,5,9}
lvt={4,10,19,32}

function lvn(l)
 return l<5 and lvt[l] or 32+(l-4)*18
end

function _init()
 cartdata("pegdungeon_rjf")
 hi=dget(0)
 tdone=dget(1)
 tk=0 shk=0 frz=0 hfl=0
 gl=0 ramp=0 shat=0 rft=0
 rfi=0 score=0 fnum=1
 hp=6 mhp=6 nen=0
 nmv=0 nkl=0 tut=false
 fts={} bd={}
 an=nil sel=nil
 st=0
 menuitem(1,"restart floor",rst)
end

function newrun(t)
 hp=6 mhp=6 atk=0 dur=0
 xp=0 lvl=1 pot=0
 score=0 tut=t
 fnum=t and 0 or 1
 startfloor()
end

function startfloor()
 for g=1,4 do
  gen()
  if nen>3 then break end
 end
 -- snapshot the floor as generated
 -- so the pause menu can put the
 -- player back at its first move.
 bd0={}
 for i=0,195 do bd0[i]=bd[i] end
 sv={hp,atk,dur,pot,xp,lvl,mhp,nen}
 reset()
 music(0)
end

function reset()
 for i=0,195 do bd[i]=bd0[i] end
 hp,atk,dur,pot,xp,lvl,mhp,nen=unpack(sv)
 nmv=0 nkl=0
 curx=6 cury=6
 for i=0,195 do
  if bd[i]>1 then
   curx=i%14 cury=i\14
   break
  end
 end
 sel=nil an=nil
 fts={}
 frz=0 shk=0 hfl=0 gl=0
 shat=0 rft=0 ramp=0
 xp0=xp st=1
end

function rst()
 if st==1 then reset() end
end
-->8
-- generation

function inm(x,y,k)
 local d=abs(x-6.5)+abs(y-6.5)
 if k==0 then
  return (x>4 and x<9 and y>0 and y<13)
   or (y>4 and y<9 and x>0 and x<13)
 elseif k==1 then
  return d<=6.5
 elseif k==2 then
  return d<=6.5 and (d>=4.5 or d<=1.5
   or abs(x-6.5)<1 or abs(y-6.5)<1)
 end
 return y>2 and y<13
  and abs(x-6.5)<=(y-2)*0.75
end

function nbr(x,y)
 local c=0
 for d=1,4 do
  local a,b=x+dx[d],y+dy[d]
  if a>=0 and a<14 and b>=0 and b<14
   and bd[a+b*14]>0 then c+=1 end
 end
 return c
end

function mkmask()
 local k=flr(rnd(5))
 bd={}
 for i=0,195 do bd[i]=0 end
 if tut then
  -- small fixed diamond, and short
  -- enough that the hint band below
  -- it never covers the board
  for y=0,13 do
   for x=0,13 do
    if abs(x-6.5)+abs(y-6.5)<=4.5 then
     bd[x+y*14]=1
    end
   end
  end
  return
 end
 if k<4 then
  for y=0,13 do
   for x=0,13 do
    if inm(x,y,k) then bd[x+y*14]=1 end
   end
  end
 else
  bd[90]=1
  local n,t,g=1,58+flr(rnd(22)),0
  while n<t and g<9000 do
   g+=1
   local x,y=flr(rnd(14)),flr(rnd(14))
   local i=x+y*14
   if bd[i]==0 and nbr(x,y)>0 then
    bd[i]=1 n+=1
   end
  end
  for y=1,12 do
   for x=1,12 do
    if bd[x+y*14]==0 and nbr(x,y)==4 then
     bd[x+y*14]=1
    end
   end
  end
 end
end

-- build backwards from a nearly
-- empty board: every inverse jump
-- adds one peg, so reversing the
-- record gives a solution that
-- is correct by construction.
function gen()
 mkmask()
 local cl={}
 for i=0,195 do
  if bd[i]==1 then add(cl,i) end
 end
 local n=#cl
 idt={}
 local nid,pl=0,0
 local sd=1+flr(rnd(3))
 for g=1,400 do
  if pl>=sd then break end
  local i=cl[1+flr(rnd(n))]
  if bd[i]==1
   and abs(i%14-6.5)+abs(i\14-6.5)<5 then
   bd[i]=2 nid+=1 idt[i]=nid pl+=1
  end
 end
 if pl==0 then
  local i=cl[1]
  bd[i]=2 nid=1 idt[i]=1 pl=1
 end

 local stp,mvf={},{}
 for p=1,n-pl do
  local ba,pr={},{}
  for i=0,195 do
   if bd[i]>1 then
    local x,y=i%14,i\14
    for d=1,4 do
     local ax=x+dx[d]*2
     local ay=y+dy[d]*2
     if ax>=0 and ax<14
      and ay>=0 and ay<14
      and bd[x+dx[d]+(y+dy[d])*14]==1
      and bd[ax+ay*14]==1 then
      add(ba,i*4+d-1)
      if mvf[idt[i]] then
       add(pr,i*4+d-1)
      end
     end
    end
   end
  end
  local po=ba
  if #pr>0 and rnd()<0.75 then po=pr end
  if #po<1 then break end
  local e=po[1+flr(rnd(#po))]
  local ci,d=e\4,e%4+1
  local x,y=ci%14,ci\14
  local bi=(x+dx[d])+(y+dy[d])*14
  local ai=(x+dx[d]*2)+(y+dy[d]*2)*14
  bd[ai]=2 idt[ai]=idt[ci]
  bd[bi]=2 nid+=1 idt[bi]=nid
  bd[ci]=1
  mvf[idt[ai]]=true
  add(stp,{idt[ai],idt[bi],ai,bi,ci})
 end
 sol=stp

 -- walk the forward solution and
 -- hand out types while simulating
 -- the hero, so the canonical solve
 -- is always survivable.
 local k=#stp
 par=pl
 local ty={}
 local shp,sat,sdu=hp,atk,dur
 local sxp,slv,smh,spo=xp,lvl,mhp,pot
 local et=flr((k+pl)*(0.26+min(0.1,fnum*0.015)))
 local tc=mid(2,1+flr(fnum/1.5),4)
 local sp=min(5,3+flr(fnum/3))
 if tut then et=4 tc=2 sp=2 end
 local ec,ss=0,9
 for j=k,1,-1 do
  local vd=stp[j][2]
  if shp<=3 and spo>0 then
   spo-=1 shp=min(smh,shp+4)
  end
  local t=2
  if ss>=sp then
   t=4 ss=0
  elseif mvf[vd] then
   t=rnd()<0.2 and 3 or 2
  elseif ec<et then
   local tr=tc
   if rnd()<0.45 then tr=max(1,tr-1) end
   if tr>3 and rnd()<0.6 then tr=3 end
   while tr>1
    and shp-max(0,pw[tr]-sat)<=2 do
    tr-=1
   end
   if shp-max(0,pw[tr]-sat)>1 then
    t=4+tr ec+=1
   else
    t=3
   end
  else
   t=rnd()<0.18 and 3 or 2
  end
  ty[vd]=t
  if t>4 then
   local tr=t-4
   shp-=max(0,pw[tr]-sat)
   sxp+=xv[tr]
   if sdu>0 then
    sdu-=1
    if sdu==0 then sat=0 end
   end
   ss+=1
   while sxp>=lvn(slv) do
    slv+=1
    local g=slv>3 and 3 or 2
    smh+=g shp=min(smh,shp+g)
   end
  elseif t==4 then
   sat=min(4,sat+1)
   sdu=min(9,sdu+3)
  elseif t==3 then
   spo=min(3,spo+1)
  end
 end

 nen=0
 for i=0,195 do
  if bd[i]>1 then
   bd[i]=ty[idt[i]] or 2
   if bd[i]>4 then nen+=1 end
  end
 end
end
-->8
-- rules

function canj(x,y,d)
 local a=bd[x+y*14]
 if a<2 or a>4 then return false end
 local ax,ay=x+dx[d]*2,y+dy[d]*2
 if ax<0 or ax>13
  or ay<0 or ay>13 then return false end
 return bd[x+dx[d]+(y+dy[d])*14]>1
  and bd[ax+ay*14]==1
end

function cmv(x,y)
 for d=1,4 do
  if canj(x,y,d) then return true end
 end
 return false
end

function anyj()
 for i=0,195 do
  if bd[i]>1 and bd[i]<5
   and cmv(i%14,i\14) then
   return true
  end
 end
 return false
end

function dojump(x,y,d)
 local ai=x+y*14
 local bi=(x+dx[d])+(y+dy[d])*14
 local cx=x+dx[d]*2
 local cy=y+dy[d]*2
 local ci=cx+cy*14
 local v=bd[bi]
 bd[ci]=bd[ai] bd[ai]=1 bd[bi]=1
 nmv+=1
 an={8+x*8,2+y*8,8+cx*8,2+cy*8,
  bd[ci],0,v,
  8+(x+dx[d])*8,2+(y+dy[d])*8,ci}
 sel=nil curx=cx cury=cy
 sfx(3)
end

function resolve(v)
 if v>4 then
  local tr=v-4
  local dm=max(0,pw[tr]-atk)
  hp-=dm xp+=xv[tr] nen-=1 nkl+=1
  if dm>0 then
   shk=6 hfl=20 sfx(4)
   add(fts,{50,108,"-"..dm,0,8})
  else
   gl=14 sfx(5)
  end
  if dur>0 then
   dur-=1
   if dur==0 then
    atk=0 frz=12 shat=30 sfx(6)
   end
  end
  while xp>=lvn(lvl) do
   lvl+=1
   local g=lvl>3 and 3 or 2
   mhp+=g hp=min(mhp,hp+g)
   ramp=24 sfx(9)
   add(fts,{44,104,"level up",0,10})
  end
 elseif v==3 then
  pot=min(3,pot+1) sfx(8)
 elseif v==4 then
  atk=min(4,atk+1)
  dur=min(9,dur+3)
  gl=14 sfx(8)
 end
 if hp<=0 then
  hp=0 st=4 frz=20
  music(-1) sfx(11)
 elseif nen<1 then
  left=0
  for i=0,195 do
   if bd[i]>1 then left+=1 end
  end
  fsc=100+5*(xp-xp0)-4*left
  if left<4 then fsc+=50 end
  if left<2 then fsc+=150 end
  if tut then
   tdone=1 dset(1,1)
  else
   score+=fsc
  end
  st=3 frz=30
  music(-1) sfx(10)
 elseif not anyj() then
  st=5 frz=20
  music(-1) sfx(11)
 end
end
-->8
-- update

function _update()
 tk+=1
 if shk>0 then shk-=1 end
 if hfl>0 then hfl-=1 end
 if gl>0 then gl-=1 end
 if ramp>0 then ramp-=1 end
 if shat>0 then shat-=1 end
 if rft>0 then rft-=1 end
 for f in all(fts) do
  f[4]+=1
  if f[4]>36 then del(fts,f) end
 end
 if frz>0 then frz-=1 return end

 local o,q=btn(4),btn(5)
 local op,qp=o and not ob,q and not qb
 ob=o qb=q

 if st==0 then
  if op then newrun(tdone<1) end
  if qp then newrun(true) end
  return
 end
 if st==3 then
  if op then
   tut=false fnum+=1 startfloor()
  end
  return
 end
 if st>3 then
  if op then
   score+=pot*10
   if score>hi then
    hi=score dset(0,hi)
   end
   st=0 music(-1)
  end
  return
 end
 if an then
  an[6]+=1
  if an[6]>8 then
   local v=an[7]
   an=nil resolve(v)
  end
  return
 end

 if qp then
  -- drinking at full hp would waste
  -- the potion, so refuse it and buzz
  if pot>0 and hp<mhp then
   pot-=1 hp=min(mhp,hp+4) sfx(7)
  else
   sfx(2)
  end
 end
 if op then
  local c=bd[curx+cury*14]
  if sel then
   sel=nil sfx(0)
  -- a stone with no jump left can't
  -- be picked up: shake it instead
  -- of handing back a dead selection
  elseif c>1 and c<5
   and cmv(curx,cury) then
   sel=curx+cury*14 sfx(1)
  else
   sfx(2)
   if c>1 then
    rft=8 rfi=curx+cury*14
   end
  end
 end
 for d=1,4 do
  if btnp(d-1) then
   if sel then
    if canj(curx,cury,d) then
     dojump(curx,cury,d)
    else
     sfx(2)
    end
   else
    mvcur(d)
   end
  end
 end
end

-- the tutorial teaches by reacting
-- to what the player just did, not
-- by locking them into one move.
function hint()
 if rft>0 then
  return bd[rfi]>4 and "monsters are rooted"
   or "that stone has no jump"
 elseif sel then
  return "press a direction to jump"
 elseif nmv<1 then
  return "🅾️ picks up a stone"
 elseif nkl<1 then
  return "jump a stone over a monster"
 elseif atk<1 then
  return "jump a sword to block damage"
 elseif pot>0 and hp<mhp then
  return "❎ drinks a potion"
 elseif nen<2 then
  return "one monster left"
 end
 return "kill every monster to win"
end

function mvcur(d)
 local x,y=curx,cury
 for s=1,14 do
  x+=dx[d] y+=dy[d]
  if x<0 or x>13
   or y<0 or y>13 then return end
  if bd[x+y*14]>0 then
   curx=x cury=y sfx(0) return
  end
 end
end
-->8
-- draw

-- every string on screen gets a
-- 4-way outline so it stays
-- readable over board and panels.
-- dark purple, not black: the intro,
-- cards and hint band are black, and
-- a black outline vanishes on them.
function pr(s,x,y,c)
 for d=1,4 do
  print(s,x+dx[d],y+dy[d],1)
 end
 print(s,x,y,c)
end

function ctr(s,y,c)
 pr(s,64-#s*2,y,c)
end

function _draw()
 cls(0)
 if st==0 then drtitle() return end
 if shk>0 then
  camera(flr(rnd(5))-2,flr(rnd(5))-2)
 else
  camera()
 end
 if ramp>0 and ramp%4<2 then
  for c=1,15 do pal(c,10) end
 end
 for y=0,13 do
  for x=0,13 do
   local i=x+y*14
   local c=bd[i]
   if c>0 then
    local px,py=8+x*8,2+y*8
    spr(c==1 and 13 or 14,px,py)
    if c>1 and not (an and an[10]==i) then
     local j=0
     if rft>0 and rfi==i then
      j=rft%2*2-1
     end
     spr(c-1+((tk\8+i)%4)*16,px+j,py)
    end
   end
  end
 end
 pal()

 if sel then
  local x,y=sel%14,sel\14
  for d=1,4 do
   if canj(x,y,d) then
    local px=11+(x+dx[d]*2)*8
    local py=5+(y+dy[d]*2)*8
    local r=2+((tk%8)\4)
    circfill(px,py,r,0)
    circfill(px,py,r-1,10)
   end
  end
 end

 if an then
  local p=an[6]/8
  local ax=an[1]+(an[3]-an[1])*p
  local ay=an[2]+(an[4]-an[2])*p
   -p*(1-p)*24
  if an[6]<4 then
   for c=1,15 do pal(c,7) end
   spr(an[7]-1,an[8],an[9])
   pal()
  else
   local r=(an[6]-4)*1.5
   local pc=an[7]>4 and 8 or 6
   for q=0,3 do
    circfill(an[8]+3+cos(q/4)*r,
     an[9]+3+sin(q/4)*r,1,pc)
   end
  end
  spr(an[5]-1,ax,ay)
 elseif st==1 then
  local px,py=8+curx*8,2+cury*8
  local c=sel and 10
   or (tk%16<8 and 7 or 6)
  for q=0,3 do
   local ax=px-1+(q%2)*9
   local ay=py-1+(q\2)*9
   local sx=q%2<1 and 2 or -2
   local sy=q\2<1 and 2 or -2
   line(ax,ay,ax+sx,ay,c)
   line(ax,ay,ax,ay+sy,c)
  end
 end

 camera()
 if tut and st<3 then
  local h=hint()
  rectfill(0,100,127,112,0)
  line(0,100,127,100,5)
  line(0,112,127,112,5)
  pr(h,max(2,64-#h*2),104,10)
 end
 drbar()
 for f in all(fts) do
  pr(f[3],f[1],f[2]-f[4]/3,f[5])
 end
 if shat>0 then
  ctr("the blade shatters",58,8)
 end
 if st>2 then drcard() end
end

function drbar()
 rectfill(0,113,127,127,0)
 rectfill(0,115,127,127,5)
 line(0,115,127,115,6)
 spr((dur>0 and dur<3) and 12 or 9,1,116)
 pr(atk..":"..dur,10,118,
  gl>0 and 10 or (dur==1 and 8 or 7))
 spr(10,23,116)
 rectfill(31,118,43,122,0)
 for i=0,2 do
  rectfill(32+i*4,119,34+i*4,121,
   i<pot and 11 or 6)
 end
 spr(8,44,116)
 pr(hp.."/"..mhp,53,118,
  (hfl>0 and hfl%4<2) and 8 or 7)
 pr("lv"..lvl,75,118,10)
 local a=lvl>1 and lvn(lvl-1) or 0
 local w=(11*(xp-a))\(lvn(lvl)-a)
 rectfill(74,124,87,126,0)
 if w>0 then line(75,125,75+w,125,9) end
 pr(tut and "tut" or "f"..fnum,
  90,118,tut and 10 or 6)
 spr(11,103,116)
 pr(nen,112,118,nen>0 and 7 or 11)
end

function drcard()
 rectfill(21,37,112,93,1)
 rectfill(18,34,109,90,0)
 rect(18,34,109,90,7)
 rect(20,36,107,88,5)
 if st==3 and tut then
  ctr("tutorial done",41,11)
  ctr("route the stones so",53,7)
  ctr("every monster dies",61,7)
  ctr("and you live",69,7)
  pr("🅾️ enter the dungeon",24,81,10)
 elseif st==3 then
  ctr("floor cleared",41,11)
  ctr("pegs left "..left.." (par "..par..")",53,7)
  ctr("floor score "..fsc,63,10)
  ctr("total "..score,71,10)
  pr("🅾️ next floor",34,81,6)
 else
  ctr(st==4 and "you died" or "dead end",39,8)
  ctr("floor "..fnum,49,7)
  ctr("score "..(score+pot*10),59,10)
  ctr("best "..hi,67,6)
  pr("🅾️ title",42,81,6)
 end
end

function drtitle()
 cls(0)
 rectfill(0,28,127,46,2)
 line(0,28,127,28,13)
 line(0,46,127,46,0)
 pr("peg dungeon",41,32,7)
 pr("solitaire rpg",38,39,13)
 for i=0,6 do
  local x=22+i*12
  spr(14,x,52)
  spr(1+i+((tk\8+i)%4)*16,x,52)
 end
 pr("shove stones through the",8,68,6)
 pr("monsters. they never move.",6,75,6)
 pr("⬅️➡️⬆️⬇️ move   🅾️ take",18,88,13)
 pr("❎ drink a potion",28,96,13)
 pr("🅾️ start   ❎ tutorial",20,108,10)
 pr("best "..hi,46,118,9)
end

