pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- triad label generator
-- draws the 128x128 cover art and
-- dumps it as __label__ hex rows.
-- see PICO8-LABEL.md

hx="0123456789abcdef"
cols={8,11,13}
bay={0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5}

function dith(x,y,t)
 return t*16>bay[(y%4)*4+(x%4)+1]
end

-->8
-- block font: 4x5 cells drawn as
-- 5x5 blocks -> 20x25 letters.
-- 5px cells keep the counter of the
-- d open; at 4px it closed up and
-- the d read as an o at thumbnail
-- size.
blk=5

font={
 t={"####",".##.",".##.",".##.",".##."},
 r={"###.","#..#","###.","#.#.","#..#"},
 i={"####",".##.",".##.",".##.","####"},
 a={".##.","#..#","####","#..#","#..#"},
 d={"###.","##.#","##.#","##.#","###."},
}

function gat(g,x,y)
 if x<1 or x>4 or y<1 or y>5 then return false end
 return sub(g[y],x,x)=="#"
end

-- emboss the outer contour only, never
-- the individual cells
function glyph(g,ox,oy,c,lt,dk)
 for ry=1,5 do
  for rx=1,4 do
   if gat(g,rx,ry) then
    local x=ox+(rx-1)*blk
    local y=oy+(ry-1)*blk
    local e=blk-1
    rectfill(x,y,x+e,y+e,c)
    if not gat(g,rx,ry-1) then line(x,y,x+e,y,lt) end
    if not gat(g,rx-1,ry) then line(x,y,x,y+e,lt) end
    if not gat(g,rx,ry+1) then line(x,y+e,x+e,y+e,dk) end
    if not gat(g,rx+1,ry) then line(x+e,y,x+e,y+e,dk) end
   end
  end
 end
end

word="triad"

function drword(ox,oy,c,lt,dk)
 for i=1,#word do
  glyph(font[sub(word,i,i)],ox+(i-1)*(blk*4+4),oy,c,lt,dk)
 end
end

function title(ox,oy)
 for i=-1,1 do
  for j=-1,1 do
   drword(ox+i,oy+j,0,0,0)
  end
 end
 drword(ox+2,oy+3,0,0,0)
 drword(ox,oy,9,10,8)
end

-->8
-- cards at label scale: 40x52,
-- shapes blown up to 24x12

function lcard(id,x,y)
 rectfill(x+3,y+4,x+42,y+55,0)
 line(x+1,y,x+38,y,0)
 line(x+1,y+51,x+38,y+51,0)
 line(x,y+1,x,y+50,0)
 line(x+39,y+1,x+39,y+50,0)
 fillp(0b1110111110111111)
 rectfill(x+1,y+1,x+38,y+50,0x76)
 fillp()
 line(x+1,y+1,x+38,y+1,7)
 line(x+1,y+1,x+1,y+50,7)
 line(x+2,y+50,x+38,y+50,6)
 line(x+38,y+2,x+38,y+49,6)
 pset(x+1,y+1,0) pset(x+38,y+1,0)
 pset(x+1,y+50,0) pset(x+38,y+50,0)
 local n=id%3
 local sp=16+(((id\3)%3)*3+(id\27)%3)*2
 local sx=(sp%16)*8
 local sy=(sp\16)*8
 local slots={{1},{0,2},{0,1,2}}
 pal(7,cols[(id\9)%3+1])
 for s in all(slots[n+1]) do
  sspr(sx,sy,16,8,x+8,y+6+s*14,24,12)
 end
 pal()
end

-->8
-- compose

-- ground: dark blue fading to black
cls(1)
for y=0,127 do
 for x=0,127 do
  if dith(x,y,(y/127)*0.95) then
   pset(x,y,0)
  end
 end
end

-- glow behind the cards
for y=36,116 do
 for x=0,127 do
  local d=1-abs(y-76)/44
  if d>0 and dith(x,y,d*0.45) then
   pset(x,y,13)
  end
 end
end

-- title band
rectfill(0,0,127,34,0)
fillp(0b1010010110100101)
rectfill(0,35,127,37,0x10)
fillp()

-- cards 0 / 40 / 80: a real trio in
-- which all four properties differ
lcard(63,1,52)
lcard(7,43,52)
lcard(50,85,52)

-- caption band
fillp(0b1010010110100101)
rectfill(0,106,127,107,0x01)
fillp()
rectfill(0,108,127,127,0)

title(6,5)

print("each property all same",20,111,7)
print("or all different",32,118,10)

printh("@@begin")
for y=0,127 do
 local s=""
 for x=0,127 do
  local c=pget(x,y)
  s=s..sub(hx,c+1,c+1)
 end
 printh(s)
end
printh("@@end")
extcmd("shutdown")
