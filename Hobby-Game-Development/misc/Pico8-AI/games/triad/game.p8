pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- triad
-- by roberto freire

cx={3,32,61}
cy={15,53,91}
cols={8,11,13}
mults={1,1.5,2,2.5,3}
mtxt={"","x1.5","x2","x2.5","x3"}

function _init()
 cartdata("triad_rjf_1")
 maxsc=dget(0)
 board={} backlog={} ba={} ka={}
 sel={} bt={} parts={}
 tk=0 tr=0 stt=0 hold=0
 score=0 dscore=0 chain=1
 cur=1 curx=3 cury=15
 popl=0 poptxt="" popc=7
 sparkle=0
 tpage=1
 newrec=false
 mkdeck()
 st="title"
 music(0,0,3)
end

-->8
-- card model

function istrio(a,b,c)
 local d=1
 for i=1,4 do
  if ((a\d)%3+(b\d)%3+(c\d)%3)%3!=0 then return false end
  d*=3
 end
 return true
end

function comp(a,b)
 local id,d=0,1
 for i=1,4 do
  id+=((6-(a\d)%3-(b\d)%3)%3)*d
  d*=3
 end
 return id
end

-- all trios in a 9-slot board
function scan(b)
 local r={}
 for i=1,7 do
  local p=b[i]
  if p then
   for j=i+1,8 do
    local q=b[j]
    if q then
     for k=j+1,9 do
      local s=b[k]
      if s and istrio(p,q,s) then
       add(r,{i,j,k})
      end
     end
    end
   end
  end
 end
 return r
end

-->8
-- deck & generation

function mkdeck()
 deck={}
 for i=0,80 do add(deck,i) end
end

-- refill the bag with every card
-- that is not currently in play
function topup()
 if #deck>=12 then return end
 local u={}
 for i=1,9 do
  if board[i] then u[board[i]]=true end
 end
 for i=1,3 do
  if backlog[i] then u[backlog[i]]=true end
 end
 for v in all(deck) do u[v]=true end
 for i=0,80 do
  if not u[i] then add(deck,i) end
 end
end

function dpull()
 if #deck<1 then topup() end
 if #deck<1 then mkdeck() end
 local i=1+flr(rnd(#deck))
 local v=deck[i]
 deli(deck,i)
 return v
end

function dpush(v) add(deck,v) end

function shuf(t)
 for i=#t,2,-1 do
  local j=1+flr(rnd(i))
  t[i],t[j]=t[j],t[i]
 end
end

-- 3 cards forming a trio,
-- all pulled out of the bag
function gtrio()
 for a=1,30 do
  local p,q=dpull(),dpull()
  local c=comp(p,q)
  for i=1,#deck do
   if deck[i]==c then
    deli(deck,i)
    return {p,q,c}
   end
  end
  dpush(p) dpush(q)
 end
end

-- opening board: two disjoint
-- trios + 3 fillers, retried
-- until exactly 2 trios exist
function gboard()
 local best
 for a=1,40 do
  topup()
  local t1=gtrio()
  local t2=gtrio()
  if t1 and t2 then
   local b={}
   for v in all(t1) do add(b,v) end
   for v in all(t2) do add(b,v) end
   for i=1,3 do add(b,dpull()) end
   shuf(b)
   local n=#scan(b)
   if n==2 then return b end
   if not best then
    best=b
   else
    for v in all(b) do dpush(v) end
   end
  end
 end
 return best
end

-- 50% loaded (is itself a trio),
-- 50% raw (never a trio)
function gback()
 topup()
 if rnd()<0.5 then
  local t=gtrio()
  if t then return t end
 end
 for a=1,30 do
  local p,q,r=dpull(),dpull(),dpull()
  if not istrio(p,q,r) then
   return {p,q,r}
  end
  dpush(p) dpush(q) dpush(r)
 end
 return {dpull(),dpull(),dpull()}
end

-->8
-- turn loop

function tx(i) return cx[1+(i-1)%3] end
function ty(i) return cy[1+(i-1)\3] end

function issel(i)
 for v in all(sel) do
  if v==i then return true end
 end
end

function startrun()
 score=0 dscore=0 chain=1
 cur=1 sel={} parts={}
 tr=0 popl=0 hold=0
 newrec=false
 board={} backlog={}
 mkdeck()
 board=gboard()
 backlog=gback()
 bt=scan(board)
 ba={} ka={}
 for i=1,9 do
  ba[i]={x=tx(i),y=ty(i)-150,l=0,s=1,d=(i-1)*2,v=0}
 end
 for i=1,3 do
  ka[i]={x=150,y=cy[i],l=0,s=1,d=14+i*3}
 end
 curx=tx(1) cury=ty(1)
 music(4,400,3)
 st="deal" stt=0
end

function ease(a,gx,gy)
 if a.d>0 then a.d-=1 return end
 a.x+=(gx-a.x)*0.3
 a.y+=(gy-a.y)*0.3
end

function animall()
 for i=1,9 do
  local a=ba[i]
  if a then
   ease(a,tx(i),ty(i))
   local w=issel(i) and 3 or 0
   a.l+=(w-a.l)*0.4
  end
 end
 for i=1,3 do
  local a=ka[i]
  if a then ease(a,96,cy[i]) end
 end
 curx+=(tx(cur)-curx)*0.45
 cury+=(ty(cur)-cury)*0.45
end

function playinput()
 local r,c=(cur-1)\3,(cur-1)%3
 if btnp(0) then c=(c+2)%3 end
 if btnp(1) then c=(c+1)%3 end
 if btnp(2) then r=(r+2)%3 end
 if btnp(3) then r=(r+1)%3 end
 local n=r*3+c+1
 if n!=cur then
  cur=n
  sfx(0)
 end
 if btnp(4) and #sel>0 then
  sel={} sfx(4)
 end
 if btnp(5) then
  local hit
  for i=1,#sel do
   if sel[i]==cur then hit=i end
  end
  if hit then
   deli(sel,hit)
   sfx(4)
  elseif board[cur] then
   add(sel,cur)
   sfx(#sel)
   puff(cur,7)
   if #sel==3 then evaluate() end
  end
 end
end

function evaluate()
 local a=board[sel[1]]
 local b=board[sel[2]]
 local c=board[sel[3]]
 if not istrio(a,b,c) then
  score=max(0,score-25)
  chain=1
  tr=5
  popup("-25",8)
  sfx(5)
  st="bad" stt=0
  return
 end
 -- difficulty: +25 per property
 -- that is all-different
 local db,d=0,1
 for i=1,4 do
  if (a\d)%3!=(b\d)%3 then db+=25 end
  d*=3
 end
 -- the board after the refill is
 -- fully determined: build it
 local nb={}
 for i=1,9 do nb[i]=board[i] end
 for i in all(sel) do nb[i]=nil end
 local k=1
 for i=1,9 do
  if not nb[i] then
   nb[i]=backlog[k] k+=1
  end
 end
 local nt=#scan(nb)
 local pts=flr((100+db+max(0,nt-1)*50)*mults[chain])
 score+=pts
 popup("+"..pts,10)
 if score>maxsc then
  maxsc=score
  dset(0,maxsc)
  if not newrec then
   newrec=true
   tr=7
   sfx(12)
   for i=1,24 do
    spark(rnd(128),rnd(10),9+flr(rnd(3)))
   end
  end
 end
 if nt>=2 then
  if chain<5 then
   chain+=1
   sfx(11)
  end
  sparkle=20
 else
  chain=1
 end
 tr=3
 sfx(6)
 for i in all(sel) do
  burst(i)
 end
 st="res" stt=0
end

function dorefill()
 for i in all(sel) do
  board[i]=nil
  ba[i].s=1
 end
 local k=1
 for i=1,9 do
  if not board[i] then
   board[i]=backlog[k]
   local a=ba[i]
   a.x=96 a.y=ka[k].y
   a.l=0 a.d=(k-1)*3
   k+=1
  end
 end
 backlog={}
 sel={}
 bt=scan(board)
 sfx(7)
 st="refill" stt=0
end

function dorestock()
 backlog=gback()
 for i=1,3 do
  ka[i]={x=150,y=cy[i],l=0,s=1,d=(i-1)*3}
 end
 sfx(9)
 st="stock" stt=0
end

function goover()
 st="over" stt=0
 tr=8
 music(-1,300)
 sfx(13)
 for i=1,9 do ba[i].v=0 end
end

function _update()
 tk+=1
 tr*=0.86
 if sparkle>0 then sparkle-=1 end
 if popl>0 then popl-=1 end
 upparts()
 if dscore!=score then
  local step=max(1,abs(score-dscore)\5)
  if dscore<score then
   dscore=min(score,dscore+step)
  else
   dscore=max(score,dscore-step)
  end
  if tk%3==0 then sfx(10) end
 end

 if st=="title" then
  if btnp(5) then startrun() end
  if btnp(4) then
   st="tut" tpage=1 sfx(1)
  end
 elseif st=="tut" then
  if btnp(5) then
   tpage+=1
   if tpage>3 then
    st="title" tpage=1 sfx(4)
   else
    sfx(2)
   end
  end
  if btnp(4) then
   st="title" tpage=1 sfx(4)
  end
 elseif st=="deal" then
  animall()
  stt+=1
  if stt==20 then sfx(8) end
  if stt>40 then st="play" end
 elseif st=="play" then
  animall()
  playinput()
 elseif st=="bad" then
  animall()
  stt+=1
  if stt>10 then
   sel={} st="play"
  end
 elseif st=="res" then
  stt+=1
  for i in all(sel) do
   ba[i].s=max(0,1-stt/8)
  end
  if stt==9 then
   for i in all(sel) do board[i]=nil end
  end
  if stt>=15 then dorefill() end
 elseif st=="refill" then
  animall()
  stt+=1
  if stt==6 then sfx(8) end
  if stt>14 then dorestock() end
 elseif st=="stock" then
  animall()
  stt+=1
  if stt>14 then
   if #bt==0 then
    goover()
   else
    st="play"
   end
  end
 elseif st=="over" then
  stt+=1
  for i=1,9 do
   local a=ba[i]
   if a.d>0 then a.d-=1
   else
    a.v+=0.5
    a.y+=a.v
   end
  end
  if stt==1 then
   for i=1,9 do ba[i].d=(i-1)*3 end
  end
  if btn(4) then
   hold+=1
   if hold==30 then
    maxsc=0 dset(0,0) sfx(5) tr=6
   end
  else
   hold=0
  end
  if stt>40 and btnp(5) then
   st="title"
   music(0,0,3)
  end
 end
end

-->8
-- particles

function push(x,y,c,sp)
 if #parts>47 then return end
 local a=rnd(1)
 add(parts,{
  x=x,y=y,
  dx=cos(a)*sp,dy=sin(a)*sp,
  l=14+rnd(16),c=c})
end

function burst(i)
 local a=ba[i]
 local c=cols[(board[i]\9)%3+1]
 for j=1,6 do
  push(a.x+13,a.y+17,c,1+rnd(2))
 end
end

function puff(i,c)
 local a=ba[i]
 for j=1,4 do
  push(a.x+13,a.y+32,c,0.7)
 end
end

function spark(x,y,c)
 add(parts,{
  x=x,y=y,dx=rnd(2)-1,dy=rnd(1),
  l=30+rnd(20),c=c})
end

function upparts()
 for p in all(parts) do
  p.x+=p.dx
  p.y+=p.dy
  p.dy+=0.11
  p.dx*=0.94
  p.l-=1
  if p.l<=0 then del(parts,p) end
 end
end

function drparts()
 for p in all(parts) do
  pset(p.x,p.y,p.l<6 and 5 or p.c)
 end
end

function popup(s,c)
 poptxt=s popc=c popl=26
end

-->8
-- drawing

function oprint(s,x,y,c,o)
 o=o or 0
 for i=-1,1 do
  for j=-1,1 do
   if i!=0 or j!=0 then
    print(s,x+i,y+j,o)
   end
  end
 end
 print(s,x,y,c)
end

function dcard(id,x,y,s,sl)
 x=flr(x) y=flr(y)
 if s<0.02 then return end
 if s<1 then
  local w,h=13*s,17*s
  rectfill(x+13-w,y+17-h,x+13+w,y+17+h,7)
  rect(x+13-w,y+17-h,x+13+w,y+17+h,cols[(id\9)%3+1])
  return
 end
 -- drop shadow
 fillp(0b1010010110100101.1)
 rectfill(x+2,y+3,x+27,y+36,0)
 fillp()
 -- outline, corners left open
 line(x+1,y,x+24,y,0)
 line(x+1,y+33,x+24,y+33,0)
 line(x,y+1,x,y+32,0)
 line(x+25,y+1,x+25,y+32,0)
 -- paper face
 fillp(0b1110111110111111)
 rectfill(x+1,y+1,x+24,y+32,0x76)
 fillp()
 -- bevel
 line(x+1,y+1,x+24,y+1,7)
 line(x+1,y+1,x+1,y+32,7)
 line(x+2,y+32,x+24,y+32,6)
 line(x+24,y+2,x+24,y+31,6)
 pset(x+1,y+1,0) pset(x+24,y+1,0)
 pset(x+1,y+32,0) pset(x+24,y+32,0)
 -- shapes
 local n=id%3
 local sp=16+(((id\3)%3)*3+(id\27)%3)*2
 pal(7,cols[(id\9)%3+1])
 if n==0 then
  spr(sp,x+5,y+13,2,1)
 elseif n==1 then
  spr(sp,x+5,y+4,2,1)
  spr(sp,x+5,y+22,2,1)
 else
  spr(sp,x+5,y+4,2,1)
  spr(sp,x+5,y+13,2,1)
  spr(sp,x+5,y+22,2,1)
 end
 pal()
 if sl then
  rect(x-1,y-1,x+26,y+34,tk%6<3 and 7 or 10)
 end
end

function dhole(x,y)
 for i=0,25,2 do
  pset(x+i,y,1)
  pset(x+i,y+33,1)
 end
 for i=0,33,2 do
  pset(x,y+i,1)
  pset(x+25,y+i,1)
 end
end

function panels()
 rectfill(0,12,89,127,3)
 fillp(0b1000001000100000)
 rectfill(0,12,89,127,0x13)
 fillp(0b1010010110100101)
 rectfill(0,12,89,17,0x13)
 rectfill(0,122,89,127,0x13)
 rectfill(0,12,5,127,0x13)
 rectfill(84,12,89,127,0x13)
 fillp()
 rectfill(90,12,127,127,0)
 fillp(0b1010010110100101)
 rectfill(90,12,91,127,0x50)
 rectfill(92,12,93,127,0x10)
 fillp()
 if sparkle>0 and tk%4<2 then
  rect(0,12,89,127,11)
 end
end

function hud()
 rectfill(0,0,127,11,0)
 fillp(0b1010010110100101.1)
 rectfill(0,12,127,13,0)
 fillp()
 oprint("score",2,1,6)
 local s=""..dscore
 oprint(s,2,6,10)
 oprint("max",127-14,1,6)
 local m=""..maxsc
 local mc=12
 if newrec then
  mc=tk%8<4 and 7 or 10
 end
 oprint(m,126-#m*4,6,mc)
 if chain>1 then
  local t=mtxt[chain]
  local w=#t*4
  local yy=3
  if sparkle>14 then yy=2 end
  oprint(t,64-w\2,yy,tk%4<2 and 10 or 7)
 end
end

function _draw()
 cls(0)
 local sx,sy=0,0
 if tr>0.3 then
  sx=rnd(tr)-tr/2
  sy=rnd(tr)-tr/2
 end
 camera(sx,sy)
 if st=="title" then
  drtitle()
  camera()
  return
 end
 if st=="tut" then
  drtut()
  camera()
  return
 end
 panels()
 for i=1,9 do
  if not board[i] then
   dhole(tx(i),ty(i))
  end
 end
 for i=1,3 do
  if backlog[i] then
   dcard(backlog[i],ka[i].x,ka[i].y,1)
  end
 end
 if st=="play" then
  rect(curx-2,cury-2,curx+27,cury+35,tk%8<4 and 10 or 7)
 end
 for i=1,9 do
  if board[i] then
   local a=ba[i]
   local ox=0
   if st=="bad" and issel(i) then
    ox=(stt%4<2) and 2 or -2
   end
   dcard(board[i],a.x+ox,a.y-a.l,a.s,issel(i))
  end
 end
 drparts()
 if st=="over" then
  fillp(0b1010010110100101.1)
  rectfill(0,14,127,127,0)
  fillp()
 end
 hud()
 if popl>0 then
  local w=#poptxt*4
  oprint(poptxt,64-w\2,60-(26-popl),popc)
 end
 if st=="res" and stt<4 then
  fillp(0b1010010110100101.1)
  rectfill(0,0,127,127,7)
  fillp()
 end
 if st=="bad" and stt<3 then
  fillp(0b1010010110100101.1)
  rectfill(0,0,127,127,8)
  fillp()
 end
 if st=="over" then drover() end
 camera()
end

function drtitle()
 rectfill(0,0,127,127,1)
 fillp(0b1000001000100000)
 rectfill(0,0,127,127,0xd1)
 fillp()
 fillp(0b1010010110100101.1)
 rectfill(0,12,127,30,0)
 fillp()
 oprint("\^w\^ttriad",44,14,10)
 -- 63/7/50: every property differs
 dcard(63,8,36,1)
 dcard(7,51,36,1)
 dcard(50,94,36,1)
 oprint("each property all same",20,76,7)
 oprint("or all different",32,83,7)
 oprint("here: all four differ",22,93,11)
 if tk%30<20 then
  oprint("❎ start",48,104,10)
 end
 oprint("🅾️ tutorial",42,113,7)
 oprint("max "..maxsc,2,121,12)
end

-- tutorial pages. b is the property
-- that fails, 0 when the three cards
-- really are a trio. driver.lua checks
-- every claim below against the cards.
pnam={"number","shape","color","fill"}
tut={
 {c={0,1,2},t="a trio",k=11,b=0,
  n="three match, one varies",
  p={"all different","all the same",
     "all the same","all the same"}},
 {c={11,41,71},t="a trio",k=11,b=0,
  n="any mix of same and different",
  p={"all the same","all different",
     "all the same","all different"}},
 {c={0,1,11},t="not a trio",k=8,b=3,
  n="one bad property fails it all",
  p={"all different","all the same",
     "two red, one green","all the same"}},
}

function drtut()
 local d=tut[tpage]
 rectfill(0,0,127,127,1)
 fillp(0b1000001000100000)
 rectfill(0,0,127,127,0xd1)
 fillp()
 fillp(0b1010010110100101.1)
 rectfill(0,0,127,10,0)
 fillp()
 oprint(d.t,64-#d.t*2,2,d.k)
 dcard(d.c[1],8,13,1)
 dcard(d.c[2],51,13,1)
 dcard(d.c[3],94,13,1)
 for i=1,4 do
  local y=47+i*9
  oprint(pnam[i],8,y,6)
  oprint(d.p[i],44,y,i==d.b and 8 or 11)
 end
 oprint(d.n,64-#d.n*2,94,7)
 for i=1,3 do
  local x=56+i*6
  if i==tpage then
   rectfill(x,105,x+3,108,10)
  else
   rect(x,105,x+3,108,5)
  end
 end
 if tk%30<20 then
  oprint(tpage<3 and "❎ next" or "❎ done",30,116,10)
  oprint("🅾️ back",70,116,7)
 end
end

function drover()
 rectfill(14,44,113,84,0)
 rect(14,44,113,84,8)
 oprint("no trios left",34,50,8)
 oprint("score "..score,64-#(""..score)*2-12,60,10)
 if newrec then
  oprint("new record!",41,68,tk%8<4 and 7 or 10)
 else
  oprint("max "..maxsc,64-#(""..maxsc)*2-8,68,12)
 end
 if stt>40 and tk%30<20 then
  oprint("❎ again",46,76,7)
 end
 if hold>0 and hold<30 then
  rectfill(20,88,20+hold*2,92,8)
  oprint("clearing max",34,94,6)
 end
end
