pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- lockstep label generator
-- run headlessly, then splice:
--   pico8 -x labelgen.p8 > dump.txt
--   node ../../label-tool.js dump.txt game.p8 preview.png 3
-- its __gfx__ is copied from game.p8 by gen.js, so the label
-- always shows the game's real sprites at 2x.

hx="0123456789abcdef"

-- 4x5 block font. 4 cells wide, not 3: at 3 cells
-- (split needs convert=false, or "0001" becomes 1)
-- p reads as f and n reads as h.
fnt={}
fnt["l"]=split("1000,1000,1000,1000,1111",",",false)
fnt["o"]=split("1111,1001,1001,1001,1111",",",false)
fnt["c"]=split("1111,1000,1000,1000,1111",",",false)
fnt["k"]=split("1001,1010,1100,1010,1001",",",false)
fnt["s"]=split("1111,1000,1111,0001,1111",",",false)
fnt["t"]=split("1111,0110,0110,0110,0110",",",false)
fnt["e"]=split("1111,1000,1110,1000,1111",",",false)
fnt["p"]=split("1111,1001,1111,1000,1000",",",false)

function on(g,rx,ry)
 if ry<1 or ry>5 or rx<1 or rx>4 then return false end
 return sub(g[ry],rx,rx)=="1"
end

-- one 16x20 letter: 4x5 grid of 4x4 blocks,
-- embossed on its outer contour only
function glyph(ch,x,y,c,lt,dk)
 local g=fnt[ch]
 for ry=1,5 do
  for rx=1,4 do
   if on(g,rx,ry) then
    local px=x+(rx-1)*4
    local py=y+(ry-1)*4
    rectfill(px,py,px+3,py+3,c)
    if not on(g,rx,ry-1) then line(px,py,px+3,py,lt) end
    if not on(g,rx-1,ry) then line(px,py,px,py+3,lt) end
    if not on(g,rx,ry+1) then line(px,py+3,px+3,py+3,dk) end
    if not on(g,rx+1,ry) then line(px+3,py,px+3,py+3,dk) end
   end
  end
 end
end

function word(s,x,y,c,lt,dk)
 for i=1,#s do
  glyph(sub(s,i,i),x+(i-1)*18,y,c,lt,dk)
 end
end

-- black halo, drop shadow, then the real letters
function title(s,x,y)
 for ox=-2,2 do
  for oy=-2,2 do
   word(s,x+ox,y+oy,0,0,0)
  end
 end
 word(s,x+2,y+2,0,0,0)
 word(s,x,y,10,15,9)
end

bay={0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5}
function dith(x,y,t)
 return t*16>bay[(y%4)*4+(x%4)+1]
end

-- sprites key off 14, not 0
function rp()
 pal()
 palt(0,false)
 palt(14,true)
end

-- 2x blit of one game sprite
function tile(n,cx,cy)
 sspr(n%16*8,n\16*8,8,8,cx,cy,16,16)
end

-- ---------------------------------------- compose

cls(0)
rp()

-- background: night gradient with the board's dot grid
for y=0,127 do
 for x=0,127 do
  local c=0
  if dith(x,y,1-y/150) then c=1 end
  pset(x,y,c)
 end
end
for y=2,127,8 do
 for x=2,127,8 do
  pset(x,y,1)
 end
end

-- the scene: three lanes, all stepping right at once
scene=52
pcl={12,11,10}
for r=0,2 do
 local y=scene+r*16
 tile(3,0,y)
 tile(3,112,y)
 for c=1,6 do
  tile(1,c*16,y)
 end
end
-- goals, staggered; lane 1's box is already locked
tile(16,5*16,scene)
tile(16,6*16,scene+32)
tile(18,4*16,scene+16)
-- boxes and players, with motion streaks behind them
for r=0,2 do
 local y=scene+r*16
 if r!=1 then tile(6,2*16,y) end
 for k=1,3 do
  local sx=16-k*5
  line(sx,y+6,sx+2,y+6,pcl[r+1])
  line(sx,y+10,sx+2,y+10,pcl[r+1])
 end
 pal(7,pcl[r+1])
 tile(22,16,y)
 rp()
end

title("lock",29,6)
title("step",29,28)

-- caption band
rectfill(0,106,127,127,0)
rectfill(0,106,127,106,5)
print("one press, everybody steps",12,113,6)
print("25 levels",44,120,5)

-- ---------------------------------------- dump

printh("@@begin")
for y=0,127 do
 local s=""
 for x=0,127 do
  local c=pget(x,y)
  s=s..sub(hx,c+1,c+1)
 end
 printh(s)
end
printh("@@end")
extcmd("shutdown")
