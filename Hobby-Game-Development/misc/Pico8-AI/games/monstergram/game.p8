pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- monstergram
-- by roberto freire

e={} rv={} fg={} ip={} iv={} rt={}
ps={} po={} ef={} mo={}
rr={} cr={} cn={} mk={}
-- lk is the luck budget: at most this many of the 100
-- tiles may resist pure deduction, so >=80% of every
-- board is won by reading it, not by guessing.
lk=20

function ix(x,y) return y*10+x+1 end

function _init()
 st="t" tk=0 rd=1 sc=0 kl=0
 cx=0 cy=0
 sw=0 sp=0 shk=0 fl=0 flc=7 ct=0 dt=0
 hf=0 lvf=0 xf=0 hb=0 cs=0 xw=0
 hp=3 mh=3 lv=1 xp=0
 music(0,0,7)
end

-->8
-- generation

function rn(g)
 local r,c={},0
 for i=1,10 do
  if g[i] then c+=1
  elseif c>0 then add(r,c) c=0 end
 end
 if c>0 then add(r,c) end
 return r
end

function rwr(y)
 local g={}
 for x=0,9 do g[x+1]=e[ix(x,y)]>0 end
 return rn(g)
end

function clr(x)
 local g={}
 for y=0,9 do g[y+1]=e[ix(x,y)]>0 end
 return rn(g)
end

function mkclues()
 rr={} cr={}
 for y=0,9 do rr[y]=rwr(y) end
 for x=0,9 do cr[x]=clr(x) end
end

-- a line is only allowed if the single 3-cell
-- clue strip can state it in full, one digit each
function legal(r)
 if #r>3 then return false end
 for v in all(r) do
  if v>9 then return false end
 end
 return true
end

-- enumerate every arrangement of runs r over line k
function place(k,r,i,p)
 if i>#r then
  for j=p,10 do
   if k[j]==1 then return end
  end
  tt+=1
  for j=1,10 do
   if mk[j] then cn[j]+=1 end
  end
  return
 end
 local w=r[i]
 for s=p,11-w do
  local ok=true
  for j=p,s-1 do
   if k[j]==1 then ok=false break end
  end
  if ok then
   for j=s,s+w-1 do
    if k[j]==0 then ok=false break end
   end
  end
  if ok and s+w<=10 and k[s+w]==1 then ok=false end
  if ok then
   for j=s,s+w-1 do mk[j]=true end
   place(k,r,i+1,s+w+1)
   for j=s,s+w-1 do mk[j]=false end
  end
 end
end

-- one deduction pass over a single line
function solve(k,r)
 tt=0
 for j=1,10 do cn[j]=0 mk[j]=false end
 place(k,r,1,1)
 local ch=false
 for j=1,10 do
  if k[j]==-1 then
   if cn[j]==tt then k[j]=1 ch=true
   elseif cn[j]==0 then k[j]=0 ch=true end
  end
 end
 return ch
end

-- how many tiles line logic cannot pin down
function unres()
 local k={}
 for i=1,100 do k[i]=-1 end
 local ch=true
 while ch do
  ch=false
  for y=0,9 do
   local l={}
   for x=1,10 do l[x]=k[y*10+x] end
   if solve(l,rr[y]) then
    ch=true
    for x=1,10 do k[y*10+x]=l[x] end
   end
  end
  for x=0,9 do
   local l={}
   for y=1,10 do l[y]=k[(y-1)*10+x+1] end
   if solve(l,cr[x]) then
    ch=true
    for y=1,10 do k[(y-1)*10+x+1]=l[y] end
   end
  end
 end
 local u=0
 for i=1,100 do
  if k[i]==-1 then u+=1 end
 end
 return u
end

-- monsters nest in runs, and a run is only kept
-- if every line it touches still fits the clue strip
function scatter(tot,ms)
 for i=1,100 do e[i]=0 end
 local c,gu=0,0
 while c<tot and gu<2000 do
  gu+=1
  local x,y=flr(rnd(10)),flr(rnd(10))
  local hz,ln=rnd(1)<0.5,min(2+flr(rnd(2)),tot-c)
  local ok=true
  for s=0,ln-1 do
   local tx,ty=x+(hz and s or 0),y+(hz and 0 or s)
   if tx>9 or ty>9 or e[ix(tx,ty)]>0 then ok=false break end
  end
  if ok then
   for s=0,ln-1 do
    e[ix(x+(hz and s or 0),y+(hz and 0 or s))]=ms[c+s+1]
   end
   for s=0,ln-1 do
    local tx,ty=x+(hz and s or 0),y+(hz and 0 or s)
    if not legal(rwr(ty)) or not legal(clr(tx)) then ok=false break end
   end
   if ok then
    c+=ln
   else
    for s=0,ln-1 do
     e[ix(x+(hz and s or 0),y+(hz and 0 or s))]=0
    end
   end
  end
 end
end

-- every round rolls its own dungeon instead of stepping
-- through a fixed floor table. the roll - how many monsters,
-- how they are tiered, how many swords and how sharp - is the
-- 20% luck, and it is clamped at both ends so no draw is a
-- walkover and none is unwinnable. the 80% is underneath it:
-- the field is re-scattered until at most lk tiles resist the
-- line solver, so four fifths of the board is always deducible.
function gen()
 for i=1,100 do
  ip[i]=0 iv[i]=0 rv[i]=false fg[i]=false
 end
 local tot=26+flr(rnd(12))
 local n3=flr(rnd(tot*0.35))
 local n2=flr(rnd(tot*0.45))
 local ms={}
 for c=1,tot-n2-n3 do add(ms,1) end
 for c=1,n2 do add(ms,2) end
 for c=1,n3 do add(ms,3) end
 local bf,bu={},999
 for a=1,30 do
  scatter(tot,ms)
  mkclues()
  local u=unres()
  if u<bu then
   bu=u
   for i=1,100 do bf[i]=e[i] end
  end
  if u<=lk then break end
 end
 if bu>0 then
  for i=1,100 do e[i]=bf[i] end
  mkclues()
 end
 -- swords track the blank count, and the first one is
 -- always a w3 so the roll can never strand the player
 for c=1,max(5,(100-tot)\9) do
  local i
  repeat i=flr(rnd(100))+1 until e[i]==0 and ip[i]==0
  ip[i]=1
  iv[i]=c==1 and 3 or 1+flr(rnd(3))
 end
 cx=0 cy=0
 rt={} ps={} po={} ef={} mo={}
 xw=0 hf=0 lvf=0
end

-->8
-- juice

-- every flourish funnels through four pools: ps particles,
-- po floating text, ef 16x16 sprite bursts, mo xp motes.
-- g=0 means "no drag either" - that is what the drifting
-- title-screen dust rides on.
function pt(x,y,dx,dy,c,l,g)
 if #ps>140 then return end
 add(ps,{x=x,y=y,dx=dx,dy=dy,c=c,l=l,g=g})
end

function burst(x,y,n,c,sp,g)
 for i=1,n do
  local a,v=rnd(1),sp*(0.4+rnd(0.6))
  pt(x,y,cos(a)*v,sin(a)*v,c,10+rnd(10),g)
 end
end

function pop(x,y,s,c)
 add(po,{x=mid(1,x-#s*2,127-#s*4),y=y,s=s,c=c,l=26})
end

-- b is the base sprite of a 4-frame 16x16 animation.
-- c retints the gold/orange in it, so one sparkle can
-- speak for whichever item was just picked up.
function fx(x,y,b,c)
 add(ef,{x=x-8,y=y-8,b=b,t=0,c=c})
end

function mote(x,y)
 add(mo,{x=x,y=y,vx=rnd(3)-1.5,vy=-1-rnd(1.5),t=0})
end

-- board index -> centre of its tile on screen
function cxy(i)
 local j=i-1
 return 40+(j%10)*8,32+(j\10)*8
end

function upjuice()
 for p in all(ps) do
  p.x+=p.dx p.y+=p.dy
  if p.g>0 then
   p.dy+=p.g p.dx*=0.92 p.dy*=0.96
  end
  p.l-=1
  if p.l<=0 then del(ps,p) end
 end
 for p in all(po) do
  p.l-=1
  p.y-=p.l>18 and 1 or 0.3
  if p.l<=0 then del(po,p) end
 end
 for f in all(ef) do
  f.t+=1
  if f.t>=16 then del(ef,f) end
 end
 -- a mote flies off the corpse, then homes in on the xp bar
 for m in all(mo) do
  m.t+=1
  local u=min(m.t/26,1) u*=u
  m.x+=m.vx*(1-u)+(54-m.x)*u*0.35
  m.y+=m.vy*(1-u)+(122-m.y)*u*0.35
  if m.t>=26 then del(mo,m) xf=8 sfx(24,3) end
 end
 if hf>0 then hf-=1 end
 if lvf>0 then lvf-=1 end
 if xf>0 then xf-=1 end
 if hb>0 then hb-=1 end
 if cs>0 then cs-=1 end
 if sp>0 then sp-=1 end
 xw+=(31*xp/(4+lv*2)-xw)*0.25
end

function djuice()
 for f in all(ef) do
  if f.c then pal(10,f.c) pal(9,f.c) end
  spr(f.b+(f.t\4)*2,f.x,f.y,2,2)
  if f.c then pal() end
 end
 for p in all(ps) do
  pset(p.x,p.y,p.l<5 and 5 or p.c)
 end
 for m in all(mo) do spr(11,m.x-4,m.y-4) end
 for p in all(po) do
  print(p.s,p.x,p.y+1,0)
  print(p.s,p.x,p.y,p.l<8 and 5 or p.c)
 end
end

-->8
-- play

-- sword feedback: white blink when a charge
-- goes, a loud red crack when it shatters
function spent()
 sp=10
 if sw<=0 then
  sw=0 fl=16 flc=8 sfx(8)
  burst(6,119,8,8,1.8,0.12)
  burst(6,119,5,10,1.4,0.12)
  pop(6,105,"broke",8)
 else
  fl=6 flc=7
  burst(6,119,4,7,1,0.06)
 end
end

function fight(i,x,y)
 local dm=e[i]
 if sw>0 then
  local ab=min(dm,sw)
  dm-=ab
  sw-=1
  fx(x,y,104)
  burst(x,y,6,10,1.8,0.05)
  if ab>0 then pop(x,y-7,"-"..ab,9) end
  spent()
 end
 hp-=dm
 xp+=e[i]
 kl+=1
 for k=1,e[i] do mote(x+rnd(5)-2,y+rnd(5)-2) end
 if dm>0 then
  shk=8 hf=10 hb=14 sfx(3)
  fx(x,y,64)
  burst(x,y,10,8,2.2,0.06)
  pop(x,y,"-"..dm,8)
 else
  sfx(4)
  pop(x,y,"block",10)
 end
 if xp>=4+lv*2 then
  xp=0 lv+=1 mh=min(8,mh+1) hp=mh
  lvf=40 hb=24 sfx(23)
  fx(x,y,96)
  fx(76,68,96)
  burst(76,68,24,11,2.6,0)
  pop(64,58,"level "..lv,10)
 end
 if hp<=0 then
  hp=0 st="d" dt=0 sfx(7)
  burst(x,y,24,8,3,0.05)
 end
end

function rev(i)
 if rv[i] or fg[i] then return end
 rv[i]=true rt[i]=tk
 local x,y=cxy(i)
 fx(x,y,32)
 burst(x,y,6,5,1.4,0.1)
 if e[i]>0 then
  fight(i,x,y)
 elseif ip[i]>0 then
  local v,ov=iv[i],sw
  sw=max(ov,v)
  fx(x,y,40,10)
  burst(x,y,10,10,1.6,0)
  sp=14
  if v>ov then
   pop(x,y,"sword "..v,10)
  else
   pop(x,y,"kept "..ov,6)
  end
  fl=10 flc=7 sfx(2)
 else
  sfx(25)
 end
 if st=="p" then
  for j=1,100 do
   if e[j]==0 and not rv[j] then return end
  end
  st="c" ct=0 sc+=100 sfx(6)
 end
end

function _update()
 tk+=1
 if shk>0 then shk-=1 end
 if fl>0 then fl-=1 end
 upjuice()
 if st=="t" then
  -- ambient dungeon dust behind the title
  if tk%5==0 then
   pt(rnd(128),132,rnd(0.4)-0.2,-0.3-rnd(0.5),tk%15==0 and 5 or 13,110,0)
  end
  if btnp(5) then
   rd=1 lv=1 mh=3 hp=3 xp=0 sc=0 kl=0 sw=0 sp=0
   gen() st="p"
  end
  return
 end
 if st=="d" then
  dt+=1
  if dt>=60 then st="o" end
  return
 end
 if st=="o" then
  if btnp(5) then st="t" end
  return
 end
 if st=="c" then
  ct+=1
  -- victory lap: sparks pop across the cleared field
  if ct<26 and ct%2==0 then
   local q=flr(rnd(100))+1
   local x,y=cxy(q)
   burst(x,y,3,ct%4<2 and 10 or 11,1.2,0.04)
  end
  if ct>20 and btnp(5) then
   rd+=1 gen() st="p"
  end
  return
 end
 if btnp(4) then
  local i=ix(cx,cy)
  if not rv[i] then
   fg[i]=not fg[i] sfx(1)
   local x,y=cxy(i)
   burst(x,y,5,fg[i] and 8 or 5,1.2,0.08)
  end
 end
 local dx=(btnp(1) and 1 or 0)-(btnp(0) and 1 or 0)
 local dy=(btnp(3) and 1 or 0)-(btnp(2) and 1 or 0)
 if dx!=0 or dy!=0 then cs=4 sfx(26,3) end
 cx=(cx+dx)%10 cy=(cy+dy)%10
 if btnp(5) then rev(ix(cx,cy)) end
end

-->8
-- draw

-- how many enemies in a line are already accounted for
function fcnt(x,y,rw)
 local c=0
 for i=0,9 do
  local j=rw and ix(i,y) or ix(x,i)
  if fg[j] or (rv[j] and e[j]>0) then c+=1 end
 end
 return c
end

function lcol(r,f,hl)
 if hl then return 7 end
 local s=0
 for v in all(r) do s+=v end
 return f>=s and 5 or 6
end

-- bx,by = cell nearest the field; ux,uy = step outward
function dcl(r,col,bx,by,ux,uy)
 local n=#r
 if n==0 then
  print("0",bx+2,by+2,col)
  return
 end
 for s=0,min(n,3)-1 do
  print(r[n-s],bx+ux*s+2,by+uy*s+2,col)
 end
end

function dboard()
 for y=0,9 do
  local r=rr[y]
  dcl(r,lcol(r,fcnt(0,y,true),cy==y),28,28+y*8,-8,0)
 end
 for x=0,9 do
  local r=cr[x]
  dcl(r,lcol(r,fcnt(x,0,false),cx==x),36+x*8,20,0,-8)
 end
 for y=0,9 do
  for x=0,9 do
   local i=ix(x,y)
   local sx,sy=36+x*8,28+y*8
   local a=rt[i] and tk-rt[i] or 99
   if rv[i] then
    spr(2,sx,sy)
    if a<4 then rectfill(sx,sy,sx+7,sy+7,a<2 and 7 or 6) end
    if e[i]>0 then
     spr(7,sx,sy-(a<6 and 1 or 0))
     for j=1,e[i] do pset(sx+2+j*2,sy+7,8) end
    end
   else
    spr(1,sx,sy)
    if fg[i] then spr(3,sx,sy-(tk%32<3 and 1 or 0)) end
   end
  end
 end
 local sx,sy=36+cx*8,28+cy*8
 local o=cs>0 and 1 or 0
 rect(sx-1-o,sy-1-o,sx+8+o,sy+8+o,tk%16<8 and 10 or 8)
end

function dbar()
 rectfill(0,112,127,127,0)
 line(0,111,127,111,5)
 local bc=sw>0 and 6 or 5
 if fl>0 and tk%4<2 then bc=flc end
 local o=sp>0 and 1 or 0
 rect(1-o,114-o,10+o,124+o,bc)
 if sw>0 then
  spr(8,2,115)
  rectfill(5,118,10,124,0)
  print(sw,7,119,10)
 else
  pal(6,5) pal(7,5) pal(9,5) pal(12,5) pal(14,5)
  spr(8,2,115)
  pal()
 end
 for i=1,mh do
  local c,yo=5,0
  if i<=hp then
   c=8
   if hb>0 then
    yo=hb%6<3 and -1 or 0
    if hb%4<2 then c=14 end
   end
  end
  rectfill(38+(i-1)*4,115+yo,40+(i-1)*4,117+yo,c)
 end
 rectfill(38,121,69,123,5)
 local w=flr(xw)
 if w>0 then rectfill(38,121,38+w,123,xf>0 and 7 or 11) end
 print("r"..rd,73,115,7)
 print("lv"..lv,97,115,lvf>0 and (tk%4<2 and 7 or 10) or 10)
 print(sc,73,121,6)
end

function _draw()
 cls(0)
 if st=="t" then
  print("monstergram",40,34,10)
  print("a nonogram dungeon",26,44,6)
  print("❎ start",48,64,7)
  print("numbers count monster runs",4,84,13)
  print("every blank tile is safe",8,92,13)
  print("❎ dig or fight",22,110,5)
  print("🅾️ flag a tile",22,118,5)
  djuice()
  return
 end
 if st=="o" then
  print("game over",47,34,8)
  print("rounds "..rd,42,52,7)
  print("level  "..lv,42,60,7)
  print("kills  "..kl,42,68,7)
  print("score  "..(sc+xp+kl*5),42,78,10)
  print("❎ title",48,102,6)
  return
 end
 if shk>0 then camera(rnd(3)-1,rnd(3)-1) else camera() end
 if lvf>36 then
  for c=1,15 do pal(c,7) end
 end
 dboard()
 dbar()
 djuice()
 pal()
 if hf>0 and hf%4<2 then
  rect(0,0,127,110,8)
  rect(1,1,126,109,8)
 end
 camera()
 if st=="c" then
  rectfill(18,48,109,74,0)
  rect(18,48,109,74,11)
  print("round "..rd.." cleared",34,55,11)
  print("❎ next round",38,65,7)
 end
end
