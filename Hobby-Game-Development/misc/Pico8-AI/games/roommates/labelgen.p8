-- the room

function wall()
 rectfill(0,0,127,51,13)
 for y=1,47,10 do
  for x=0,127,8 do
   pset(x+2,y,1)
   pset(x+6,y+5,1)
  end
 end
 -- framed picture, top left
 rectfill(2,4,18,16,9)
 rectfill(4,6,16,14,1)
 circfill(10,10,2,10)
 pset(7,8,7) pset(14,13,7)
 -- window, top right
 rectfill(106,3,126,19,6)
 rectfill(108,5,124,17,12)
 rectfill(108,12,124,17,3)
 line(116,5,116,17,6)
 line(108,11,124,11,6)
 circfill(112,8,2,7)
 -- skirting board
 rectfill(0,52,127,55,4)
 line(0,52,127,52,6)
 line(0,55,127,55,2)
end

function floor()
 rectfill(0,56,127,127,4)
 for y=56,127,8 do
  line(0,y,127,y,2)
  for x=(y\8%2)*16,127,32 do line(x,y+1,x,y+6,2) end
 end
 -- potted plant, bottom left
 rectfill(2,116,11,124,9)
 line(2,116,11,116,4)
 for i=0,3 do
  line(6,115,2+i*2,108-i*2,3)
  line(7,115,11-i*2,108-i*2,11)
 end
 -- floor lamp, bottom right
 line(121,127,121,96,6)
 rectfill(117,88,125,95,10)
 line(118,87,124,87,10)
end

function rug()
 rectfill(13,60,114,127,5)
 rect(13,60,114,127,6)
 rect(15,62,112,127,6)
 for i=1,5 do
  for k=63,126,4 do pset(15+i*16,k,6) end
 end
 for j=1,3 do
  for k=17,111,4 do pset(k,61+j*16,6) end
 end
end

-->8
-- the cast

-- a drifter  b homebody  c loner  d clinger  . gap
gr={"aabacc",
    "abbbac",
    "abdbac",
    "dabaa."}

function at(c,r)
 if c<0 or r<0 or c>5 or r>3 then return "." end
 return sub(gr[r+1],c+1,c+1)
end

function mad(c,r)
 local t=at(c,r)
 local n={at(c-1,r),at(c+1,r),at(c,r-1),at(c,r+1)}
 local na,nb,nc,nd=0,0,0,0
 for q in all(n) do
  if q=="a" then na+=1
  elseif q=="b" then nb+=1
  elseif q=="c" then nc+=1
  elseif q=="d" then nd+=1 end
 end
 if t=="a" then return nd>0 end
 if t=="b" then return c==0 or c==5 or r==0 or r==3 or nc>0 end
 if t=="c" then return nb+nd>0 end
 return nb==0 or na+nc>0
end

function cast()
 local ti={a=1,b=2,c=3,d=4}
 for r=0,3 do
  for c=0,5 do
   local k=at(c,r)
   if k!="." then
    local t,m=ti[k],mad(c,r) and 1 or 0
    pal(1,m==1 and 8 or 0)
    pal(3,bd[t])
    pal(4,hl[t])
    spr((t-1)*4+((c+r)%2)*2+m*32,16+c*16,62+r*16,2,2)
    if m==1 then printh("mad "..c..","..r.." "..k) end
   end
  end
 end
 pal()
end

-->8
-- block title

function gl(w,...)
 return {w=w,...}
end

fnt={
 r=gl(3,"111","101","111","110","101"),
 o=gl(3,"111","101","101","101","111"),
 m=gl(4,"1001","1111","1111","1001","1001"),
 a=gl(3,"111","101","111","101","101"),
 t=gl(3,"111","010","010","010","010"),
 e=gl(3,"111","100","111","100","111"),
 s=gl(3,"111","100","111","001","111")
}

cw=5 ch=4

function gat(g,x,y)
 if x<0 or y<0 or x>=g.w or y>4 then return false end
 return sub(g[y+1],x+1,x+1)=="1"
end

function dgl(g,x,y,flat)
 for ry=0,4 do
  for rx=0,g.w-1 do
   if gat(g,rx,ry) then
    local px,py=x+rx*cw,y+ry*ch
    local qx,qy=px+cw-1,py+ch-1
    if flat then
     rectfill(px,py,qx,qy,flat)
    else
     rectfill(px,py,qx,qy,10)
     -- emboss the outer contour only
     if not gat(g,rx,ry-1) then line(px,py,qx,py,7) end
     if not gat(g,rx-1,ry) then line(px,py,px,qy,7) end
     if not gat(g,rx,ry+1) then line(px,qy,qx,qy,9) end
     if not gat(g,rx+1,ry) then line(qx,py,qx,qy,9) end
    end
   end
  end
 end
end

function wd(s)
 local n,w=0,0
 for i=1,#s do
  n+=1
  w+=fnt[sub(s,i,i)].w*cw
 end
 return w+(n-1)*2
end

function dwd(s,x,y,flat)
 local px=x
 for i=1,#s do
  local g=fnt[sub(s,i,i)]
  dgl(g,px,y,flat)
  px+=g.w*cw+2
 end
end

function title(s,y)
 local x=(128-wd(s))\2
 for i=-2,2 do
  for j=-2,2 do dwd(s,x+i,y+j,0) end
 end
 dwd(s,x+3,y+3,0)
 dwd(s,x,y)
end

-->8
-- compose and dump

wall()
floor()
rug()
cast()
title("room",2)
title("mates",27)

printh("@@begin")
for y=0,127 do
 local s=""
 for x=0,127 do
  local c=pget(x,y)
  s=s..sub(hx,c+1,c+1)
 end
 printh(s)
end
printh("@@end")
extcmd("shutdown")
