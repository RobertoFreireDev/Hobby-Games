pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ring sort
-- by roberto freire

-- 20 solver-verified levels,
-- "k|c|rules|p0,..,p7".
-- each pillar is bottom->top,
-- "-" is an empty pillar.
lvs=split("2|4||30,-,10,32,-,12,-,-;2|5||-,10,14,32,23,40,-,-;2|6||45,0,1,02,35,3,4,12;2|6|24|1,21,-,30,20,5,54,34;3|5|04|434,-,10,-,122,0,021,343;3|6|01|2,-,253,14,040,203,154,135;3|6|0415|055,34,2,101,435,34,21,20;3|7|04|34,306,122,64,150,545,31,602;4|5|0124|41,303,1,4304,-,41,0202,2132;4|6|1415|543,4300,-,5021,121,5023,4531,42;4|6|251514|12,5401,23,135,1240,233,5040,54;4|7|3503|0432,054,165,101,133,0525,4662,4623;4|7|160102|2144,30,6032,3251,646,5056,241,3051;5|5|120204|2442,13411,013,243,010,03,2,0324;5|6|131404|011,424,53432,034,503,15243,2151,5002;5|6|03020114|34250,42234,5004,540,131,31150,322,51;5|7|053556|25512,5131,54340,223,06036,5106,21346,4460;5|7|34230335|06444,36022,15026,25205,464,51315,360,3113;5|7|36131224|26205,6260,35323,11043,65041,201,5465,4341;5|7|36343505|60603,40241,25165,3320,4133,401,52455,1266",";",false)

-- the sheet holds ONE creature: an
-- ellipsoid in 8 body / 2 shade /
-- 14 hilite, calm at sy 0 and
-- scowling at sy 9. pal() makes the
-- other six colour slots at draw
-- time, so all seven stay
-- pixel-identical -- and the eyes
-- are 7 and 0, which pal() never
-- touches, so every colour wears
-- the same face.
rb=split"8,9,10,11,12,14,6"
rs=split"2,4,9,3,13,2,5"
rh=split"14,15,7,7,6,15,7"

-- desaturation map for the
-- dead-board fade (design 7)
gry=split"0,1,5,5,5,5,6,7,5,6,6,5,6,5,6,6"

function _init()
 cartdata("roberto_ringsort")
 unl=mid(1,dget(0),20)
 sel=mid(1,dget(1),20)
 tk=0 shk=0 prt={}
 goint()
end

function _update60()
 tk+=1
 for p in all(prt) do
  p.x+=p.dx p.y+=p.dy
  p.dy+=p.g p.dx*=.99
  p.l-=1
  if p.l<=0 then del(prt,p) end
 end
 if shk>0 then shk-=1 end
 if sc==0 then updi() else updg() end
end

function _draw()
 pal()
 palt(0,false) palt(1,true)
 if sc==0 then drwi() else drwg() end
 -- dead board desaturates over 30
 -- frames on the DISPLAY palette,
 -- so it never disturbs a draw
 if dead and dead>0 then
  -- staged sweep through the
  -- palette, not a per-frame
  -- random pick (that strobes)
  local a=min(dead,30)/30*17
  for i=0,15 do
   if i<a then pal(i,gry[i+1],1) end
  end
 end
end

-->8
-- board rules

function ld(n)
 lvn=n
 local f=split(lvs[n],"|",false)
 k=tonum(f[1]) nc=tonum(f[2])
 blk={} rul={}
 local r=f[3]
 for i=1,#r,2 do
  local a=tonum(sub(r,i,i))
  local b=tonum(sub(r,i+1,i+1))
  blk[a*8+b]=1 blk[b*8+a]=1
  add(rul,{a,b,0})
 end
 pil={}
 local ps=split(f[4],",",false)
 for i=1,8 do
  local p,s={},ps[i]
  if s!="-" then
   for j=1,#s do
    add(p,tonum(sub(s,j,j)))
   end
  end
  pil[i]=p
 end
 cur=1 hld=nil mv=0 blkf=0 lean=0
 blkd=0
 drp=nil dead=0 wint=0
 don={} glo={} bnc={}
 bkt=60 bkf={} bkj={}
 for i=0,8 do bkf[i]=0 end
 for i=1,8 do
  bnc[i]=0 glo[i]=0
  don[i]=mono(pil[i])
 end
 hx=px(1) hy=hcy(1)
end

-- a held creature floats exactly
-- one slot clear of a full stack,
-- so it never merges into the pile
-- it is hovering over. which row
-- the cursor is in sets the height.
function hcy(i) return pby(i)-18-(k-1)*6 end

-- a pillar is finished when it is
-- monochrome AND full: with k
-- rings per colour that is the
-- same as "this colour is home"
function mono(p)
 if #p!=k then return false end
 for i=2,#p do
  if p[i]!=p[1] then return false end
 end
 return true
end

function canp(c,d)
 local p=pil[d]
 if #p>=k then return false end
 if #p==0 then return true end
 return not blk[c*8+p[#p]]
end

-- which rule plate to flash when a
-- drop is refused (design 6.3)
function why(c,d)
 local p=pil[d]
 if #p==0 then return end
 local t=p[#p]
 for i=1,#rul do
  local r=rul[i]
  if (r[1]==c and r[2]==t)
  or (r[2]==c and r[1]==t) then
   return i
  end
 end
end

function solved()
 for i=1,8 do
  local p=pil[i]
  if #p>0 and not mono(p) then
   return false
  end
 end
 return true
end

-- is there any legal move that is
-- not just shuffling a finished
-- pillar? (design 7)
function hasmv()
 for s=1,8 do
  local p=pil[s]
  if #p>0 and not mono(p) then
   for d=1,8 do
    if d!=s and canp(p[#p],d) then
     return true
    end
   end
  end
 end
 return false
end

-- board geometry. the eight
-- pillars sit as two rows of four,
-- so each one gets 32px of width
-- instead of 16 and the rings can
-- be 24px wide.
--   px  left edge of pillar i
--   pby y the stack rests on
--   ry  top edge of creature j
-- they are 24x9 on a 6px pitch, so
-- each one covers the crown of the
-- one below: a stack reads as a
-- totem of faces rather than a row
-- of loose chips.
function px(i) return ((i-1)%4)*32 end
function pby(i) return ((i-1)\4)*48+52 end
function ry(i,j) return pby(i)-9-(j-1)*6 end

-->8
-- game scene

function gogame(n)
 sc=1
 ld(n)
 menuitem(1,"back to menu",
  function() goint() end)
 menuitem(2)
 music(n<11 and 4 or 8,0,7)
end

function updg()
 for i=1,8 do
  if bnc[i]>0 then bnc[i]-=1 end
  if glo[i]>0 then glo[i]-=1 end
 end
 -- blinks. a timer fires at random
 -- intervals and shuts one random
 -- creature's eyes for 7 frames.
 -- the intervals are short enough
 -- that two or three often overlap,
 -- so the board never blinks in
 -- unison. slot 0 is the held one.
 for i=0,8 do
  if bkf[i]>0 then bkf[i]-=1 end
 end
 bkt-=1
 if bkt<=0 then
  bkt=20+rnd(70)
  local i=flr(rnd(9))
  local c=i>0 and #pil[i] or 1
  if c>0 then
   bkf[i]=7 bkj[i]=1+flr(rnd(c))
  end
 end
 for r in all(rul) do
  if r[3]>0 then r[3]-=1 end
 end
 if blkf>0 then blkf-=1 end

 -- a ring in flight: input is
 -- locked until it settles
 if drp then
  if drp.sq>0 then
   drp.sq-=1
   if drp.sq==0 then drp=nil end
  else
   drp.vy+=.55 drp.y+=drp.vy
   if drp.y>=drp.ty then
    drp.y=drp.ty drp.sq=8
    land()
   end
  end
  return
 end

 if wint>0 then
  wint+=1
  if wint>70 and (btnp(4) or btnp(5)) then
   if lvn<20 then
    sel=lvn+1 dset(1,sel)
    gogame(sel)
   else
    goint()
   end
  end
  return
 end

 if dead>0 then
  dead+=1
  if dead>40 and (btnp(4) or btnp(5)) then
   ld(lvn) sfx(11,3)
  end
  return
 end

 -- held ring eases toward the
 -- cursor pillar and its float
 -- height; lean adds the travel
 -- tilt from the animation table
 local tx=px(cur)
 lean=mid(-2,(tx-hx)*.5,2)
 hx+=(tx-hx)*.28
 if hld then hy+=(hcy(cur)-hy)*.3 end

 -- the board is a 4x2 grid now, so
 -- up/down steer between the rows.
 -- they were lift/drop aliases in a
 -- single row of eight; navigation
 -- is the better use of them here,
 -- and both face buttons still do
 -- lift and drop.
 local c0=cur
 if btnp(0) and (cur-1)%4>0 then cur-=1 end
 if btnp(1) and (cur-1)%4<3 then cur+=1 end
 if btnp(2) and cur>4 then cur-=4 end
 if btnp(3) and cur<5 then cur+=4 end
 if cur!=c0 then bnc[cur]=8 sfx(0,3) end

 if btnp(4) or btnp(5) then
  if hld==nil then lift() else drop() end
 end
end

function lift()
 local p=pil[cur]
 if #p==0 then
  sfx(7,3) shk=8 bnc[cur]=8
  return
 end
 hld=p[#p]
 hsrc=cur
 hy=ry(cur,#p)
 hx=px(cur)
 deli(p)
 sfx(1,3)
end

function drop()
 local free=cur==hsrc
 if not free and not canp(hld,cur) then
  -- blocked: the two creatures
  -- involved scowl at each other
  -- and steam, and the rule plate
  -- that refused them flashes
  sfx(6,3) shk=10 blkf=14 blkd=cur
  local w=why(hld,cur)
  if w then rul[w][3]=14 end
  local q=pil[cur]
  puff(px(cur)+16,ry(cur,#q)-1)
  puff(hx+16,hy-1)
  return
 end
 local p=pil[cur]
 add(p,hld)
 drp={p=cur,i=#p,y=hy,vy=0,sq=0,
      ty=ry(cur,#p),free=free}
 hld=nil
 if not free then mv+=1 end
end

-- called the frame a dropped ring
-- touches down
function land()
 local d=drp.p
 local p=pil[d]
 bnc[d]=6
 if drp.free then
  sfx(5,3)
  return
 end
 -- drop pitch rises with the
 -- stack, so height is audible
 sfx(2+min(2,(#p-1)\2),3)
 if mono(p) and not don[d] then
  don[d]=true
  glo[d]=24
  sfx(8,3)
  for i=1,10 do
   burst(px(d)+16,ry(d,#p)+4,p[1])
  end
 end
 if solved() then
  win()
 elseif not hasmv() then
  dead=1 sfx(14,3)
 end
end

function burst(x,y,c)
 add(prt,{x=x,y=y,
  dx=rnd(2)-1,dy=-rnd(1.6)-.3,
  g=.05,l=20+rnd(20),
  c=rh[c+1]})
end

-- angry steam off a scowling face
function puff(x,y)
 for i=1,5 do
  add(prt,{x=x+rnd(14)-7,y=y,
   dx=rnd(1.2)-.6,dy=-rnd(1)-.5,
   g=.03,l=16+rnd(10),
   c=rnd()<.5 and 8 or 7})
 end
end

function win()
 wint=1
 music(12,0,7)
 sfx(9,3)
 local b=dget(1+lvn)
 if b==0 or mv<b then dset(1+lvn,mv) end
 if lvn>=unl and unl<20 then
  unl=lvn+1 dset(0,unl)
 end
 -- every ring becomes confetti
 for i=1,8 do
  local p=pil[i]
  for j=1,#p do
   add(prt,{x=px(i)+16,y=ry(i,j)+4,
    dx=rnd(3)-1.5,dy=-rnd(3)-1,
    g=.09,l=60+rnd(40),c=rb[p[j]+1]})
  end
 end
end

-->8
-- game drawing

function drwg()
 bg()
 local sx=shk>0 and (shk%2*2-1) or 0
 -- a refused pair jitters for as
 -- long as it is scowling
 local jt=blkf%4<2 and 1 or -1

 for i=1,8 do
  local x,by=px(i),pby(i)
  local p=pil[i]
  local b=bnc[i]>0 and 1 or 0
  local fl=glo[i]>0 and glo[i]%4<2
  pdef()
  -- base
  rectfill(x+3,by,x+28,by+2,5)
  line(x+4,by,x+27,by,6)
  line(x+1,by+3,x+30,by+3,1)
  -- capacity line. a full stack
  -- tops out 2px under it, so a
  -- pillar touching it takes no
  -- more. it runs wider than a
  -- creature on purpose: the ends
  -- and their ticks stay visible
  -- with one hovering over them
  local ly=ry(i,k)-2
  line(x+1,ly,x+30,ly,0)
  line(x+1,ly,x+1,ly+2,0)
  line(x+30,ly,x+30,ly+2,0)
  -- bottom to top, so each creature
  -- covers the crown of the one
  -- below and only faces show. the
  -- stack sinks a pixel while the
  -- cursor sits on it
  for j=1,#p do
   local sq=0
   if drp and drp.p==i and drp.i==j then
    sq=drp.sq
   end
   local a=blkf>0 and i==blkd
    and j==#p
   dring(p[j],x+(a and jt or 0),
    dy(i,j)+b,fl,nil,sq,
    a and 9 or (bkf[i]>0
     and bkj[i]==j and 18) or 0)
  end
 end

 -- held creature, its shadow, and
 -- the pillar it would land on
 if hld then
  local p=pil[cur]
  -- the cast shadow lands on the
  -- crown of the stack below, the
  -- rows a creature above already
  -- covers -- never over a face
  local sy=#p>0 and ry(cur,#p)
   or pby(cur)-3
  fillp(0b0101101001011010.1)
  ovalfill(hx+8,sy,hx+23,sy+2,0)
  fillp()
  local a=blkf>0
  dring(hld,hx+sx+(a and jt or 0),
   hy+sin(tk/45),false,lean,0,
   a and 9 or (bkf[0]>0 and 18) or 0)
 end

 pdef()
 -- cursor chevron
 spr(10,px(cur)+12+sx,
  pby(cur)+4+(bnc[cur]>0 and 1 or 0))

 vign()
 topbar()
 drwhud()

 if wint>0 then banner() end
 if dead>0 then deadban() end
end

-- where creature j of pillar i
-- draws: its slot, unless it is the
-- one currently falling
function dy(i,j)
 if drp and drp.p==i and drp.i==j then
  return drp.y
 end
 return ry(i,j)
end

-- one creature. fl flashes it white
-- (its pillar just completed), ln
-- leans it in flight, sq squashes
-- it on landing, and fy is the
-- sheet row of the face to wear:
-- 0 calm, 9 scowling, 18 blinking.
function dring(c,x,y,fl,ln,sq,fy)
 if fl then
  pal(8,7) pal(2,6) pal(14,7)
 else
  pal(8,rb[c+1]) pal(2,rs[c+1])
  pal(14,rh[c+1])
 end
 x+=4+(ln and ln/2 or 0)
 -- squash: wider and shorter,
 -- easing back over 8 frames
 local q=sq and sq>0
  and min(sq>4 and 8-sq or sq-1,3) or 0
 sspr(0,fy,24,9,
  x-q,y+q,24+q*2,9-q)
end

function topbar()
 pdef()
 rectfill(0,0,127,7,0)
 line(0,8,127,8,1)
 otext("level "..lvn,2,1,7)
 local m="moves "..mv
 otext(m,125-#m*4,1,7)
end

-- the rule bar. each plate is two
-- colour pips with a red x, and
-- the plate that refused a drop
-- pulses with its x scaled up.
function drwhud()
 pdef()
 rectfill(0,111,127,127,0)
 line(0,111,127,111,1)
 local n=#rul
 if n==0 then
  fillp(0b0101101001011010.1)
  rectfill(14,118,113,118,6)
  fillp()
  otext("no restrictions",34,115,6)
  return
 end
 local x0=64-(n*28+(n-1)*4)/2
 for i=1,n do
  local r=rul[i]
  local x=x0+(i-1)*32
  local f=r[3]
  local bc=5
  if f>0 then bc=f%6<3 and 8 or 14 end
  rect(x,113,x+27,125,bc)
  dpip(r[1],x+1,115,f>0)
  dpip(r[2],x+19,115,f>0)
  pdef()
  if f>0 then
   -- the offending plate pulses and
   -- its x scales up (design 6.3)
   sspr(40,0,8,8,x+6,111,16,16)
  else
   spr(5,x+10,115)
  end
 end
end

function dpip(c,x,y,a)
 pal(8,rb[c+1]) pal(2,rs[c+1])
 pal(14,rh[c+1])
 spr(a and 3 or 4,x,y)
end

function banner()
 pdef()
 -- drops in, then settles at y=28
 local y=min(wint*3,42)-14
 rectfill(0,y,127,y+34,0)
 rect(0,y,127,y+34,11)
 line(0,y+1,127,y+1,3)
 otext("\^w\^tlevel clear",20,y+5,11)
 local b=dget(1+lvn)
 local s="moves "..mv.."   best "..b
 otext(s,64-#s*2,y+19,7)
 if wint>70 then
  -- a glyph counts as one char but
  -- draws 8px wide, so centre by hand
  local p=lvn<20 and "❎ next level" or "❎ menu"
  otext(p,60-#p*2,y+27,10)
 end
end

function deadban()
 local y=44
 rectfill(0,y,127,y+22,0)
 rect(0,y,127,y+22,8)
 otext("no moves left",34,y+5,8)
 if dead>40 then
  otext("🅾️ retry",42,y+13,7)
 end
end

-->8
-- intro scene

function goint()
 sc=0 cfm=0 dead=0 wint=0
 drp=nil hld=nil
 menuitem(1,"clear progress",clrp)
 menuitem(2)
 music(0,0,7)
 bgr={}
 for i=1,5 do
  add(bgr,{x=rnd(112),y=rnd(128),
   v=.1+rnd(.14)})
 end
end

-- two-step confirm: deleting
-- progress is the one destructive
-- thing in a game with no undo
function clrp()
 if cfm>0 then
  for i=0,21 do dset(i,0) end
  dset(0,1)
  unl=1 sel=1 cfm=0
  menuitem(1,"clear progress",clrp)
  sfx(11,3)
  return false
 end
 cfm=120
 menuitem(1,"sure? press again",clrp)
 sfx(6,3)
 return true
end

function updi()
 if cfm>0 then
  cfm-=1
  if cfm==0 then
   menuitem(1,"clear progress",clrp)
  end
 end
 for r in all(bgr) do
  r.y-=r.v
  if r.y<-9 then
   r.y=132 r.x=rnd(120)
  end
 end
 if btnp(0) then
  sel=sel>1 and sel-1 or 20 sfx(12,3)
 end
 if btnp(1) then
  sel=sel<20 and sel+1 or 1 sfx(12,3)
 end
 if btnp(4) or btnp(5) then
  if sel<=unl then
   dset(1,sel) sfx(10,3) gogame(sel)
  else
   sfx(6,3) shk=8
  end
 end
end

function drwi()
 bg()
 -- drifting silhouettes: only the
 -- lit crown survives the remap, and
 -- 7 goes with it so the eyes do not
 -- glow out of the background
 pal(8,1) pal(2,1) pal(14,13)
 pal(0,1) pal(7,1)
 for r in all(bgr) do
  sspr(0,0,24,9,r.x,r.y)
 end

 local ly=18+sin(tk/300)*2
 otext("\^w\^tring sort",28,ly,10)
 -- shine sweep every 4 seconds
 local s=tk%240
 if s<40 then
  local sx=28+s*2
  clip(sx,ly,4,10)
  print("\^w\^tring sort",28,ly,7)
  clip()
 end

 line(16,ly+16,111,ly+16,1)

 local sx=shk>0 and (shk%2*2-1) or 0
 pdef()
 otext("level",54+sx,43,6)
 local ls=sel<10 and "0"..sel or ""..sel
 otext("\^w\^t"..ls,58+sx,51,
  sel<=unl and 10 or 5)
 if sel>unl then spr(6,76+sx,52) end
 spr(9,30+sx,52)
 spr(9,90+sx,52,1,1,true)

 -- start plate, slow scale pulse
 local p=sin(tk/90)>0 and 1 or 0
 local c=sel<=unl and 11 or 5
 rect(38-p,68-p,89+p,82+p,c)
 rect(40,70,87,80,1)
 otext("\^w\^tstart",44,71,c)

 -- progress pips, one per level
 local ncl=0
 for i=1,20 do
  local d=dget(1+i)
  if d>0 then ncl+=1 end
  spr(d>0 and 7 or 8,4+(i-1)*6,92)
 end
 otext(ncl.."/20 cleared",36,104,6)
 otext("⬅️➡️ level   ❎ start",14,116,6)
 pal()
 palt(0,false) palt(1,true)
end

-->8
-- shared drawing

-- static gradient: solid through
-- the middle, dithered only at the
-- top and bottom edges.
--
-- the centre is where the rings
-- live, and a fill pattern behind
-- them competes with the dithering
-- on the rings themselves -- it
-- reads as noise rather than as
-- shading. so the gradient does its
-- work at the borders and gets out
-- of the way over the board.
--
-- the design's 1->13->12 is
-- reordered: colour 12 is a ring
-- colour and cannot also be sky.
-- each band pairs two colours in
-- one byte, high nibble on the set
-- bits of the pattern, low on the
-- clear ones -- so 0x1d over the
-- sparse pattern is mostly 1 with
-- flecks of 13, and the checker is
-- an even mix.
spr8=0b0111110111011111
chk8=0b0101101001011010
function bg()
 cls(1)
 -- top edge: 1 -> 13, lightening
 fillp(spr8) rectfill(0,12,127,17,0x1d)
 fillp(chk8) rectfill(0,6,127,11,0x1d)
 fillp(spr8) rectfill(0,0,127,5,0xd1)
 -- bottom edge: 1 -> 0, darkening.
 -- starts below the lower row's
 -- bases so the board itself sits
 -- on flat colour
 fillp(spr8) rectfill(0,106,127,112,0x10)
 fillp(chk8) rectfill(0,113,127,119,0x01)
 fillp(spr8) rectfill(0,120,127,127,0x01)
 fillp()
 for p in all(prt) do
  pset(p.x,p.y,p.c)
 end
end

-- dithered dark corners over the
-- board (design 8.2)
function vign()
 fillp(0b0111110111011111.1)
 rectfill(0,9,2,127,0)
 rectfill(125,9,127,127,0)
 fillp()
end

-- ring drawing leaves pal() remapped;
-- call this before any ui draw or
-- the last ring's colours leak into
-- rects, text and ui sprites.
function pdef()
 pal()
 palt(0,false) palt(1,true)
end

function otext(s,x,y,c)
 print(s,x-1,y,0) print(s,x+1,y,0)
 print(s,x,y-1,0) print(s,x,y+1,0)
 print(s,x,y,c)
end
