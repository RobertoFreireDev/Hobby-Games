pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- stack runner label generator
-- composes the 128x128 cover art
-- and dumps it as __label__ hex.
--
--   pico8 -x labelgen.p8 > dump.txt
--   node label-tool.js dump.txt game.p8 preview.png 3
--
-- every pixel is drawn with plain
-- pico-8 primitives -- the sprite
-- sheet is deliberately not used,
-- so the cover never has to be
-- redone when the game's tiles
-- change, and the runner can be
-- drawn far larger than 12x12.
--
-- palette: 0, 5, 6 and 7 only.

-- the finished art also lives in
-- this cart s own sprite sheet, a
-- 128x128 image exactly the size of
-- the label. open labelgen.p8 in
-- pico-8, repaint any pixel of it
-- in the sprite editor, save, and
-- re-run: with sheet=true the dump
-- is taken straight off the sheet,
-- so hand edits go into the label
-- untouched.
--
-- set sheet=false to throw those
-- edits away and recompose the art
-- from the code below instead --
-- then copy the new dump back into
-- __gfx__ to keep the two in step.
sheet=true

hx="0123456789abcdef"
bay={0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5}

-- silhouettes are laid down in this
-- colour and replaced by shade()
stn=12

-- ordered dither: t<=0 never, t>=1 always
function dith(x,y,t)
 return t*16>bay[(y%4)*4+(x%4)+1]
end

function hl(x0,x1,y,c)
 if x0<=x1 then rectfill(x0,y,x1,y,c) end
end

function hsh(x,y)
 return (x*17+y*29+x*y*7)%16
end

-- tapered capsule: the one shape a
-- limb, a neck or a torso is made
-- of. r0 at (x0,y0), r1 at (x1,y1).
function limb(x0,y0,x1,y1,r0,r1,c)
 local n=max(abs(x1-x0),abs(y1-y0))
 for i=0,n do
  local t=i/max(n,1)
  circfill(x0+(x1-x0)*t,y0+(y1-y0)*t,r0+(r1-r0)*t,c)
 end
end
-->8
-- lighting --
-----------------
-- one torch, on the left wall, is
-- the only light in the scene. the
-- backdrop is drawn flat and then
-- relit from it, so the brickwork,
-- the floor and the arch all fall
-- off together instead of each
-- being shaded by hand.

tox,toy=13,66   -- flame

function lit(x,y)
 local dx,dy=(x-tox)/150,(y-toy)/150
 return 1.15-sqrt(dx*dx+dy*dy)
end

function up(c) return c==0 and 5 or c==5 and 6 or c end
function dn(c) return c==7 and 6 or c==6 and 5 or c==5 and 0 or 0 end

function relight()
 for y=0,127 do
  for x=0,127 do
   local c,l=pget(x,y),lit(x,y)
   if l<0.62 then
    if dith(x,y,(0.62-l)*1.6) then c=dn(c) end
   elseif l>0.88 then
    if dith(x,y,(l-0.88)*6) then c=up(c) end
   end
   pset(x,y,c)
  end
 end
end

-->8
-- figure shading --
-----------------
-- the runner is built up one form
-- at a time. each form is drawn as
-- a flat stencil and immediately
-- shaded, so the next form laid on
-- top of it gets a real contour
-- where it overlaps -- that is what
-- keeps a leg readable against the
-- cloak behind it.
--
-- fig[y][x] remembers which pixels
-- already belong to the figure, so
-- an edge against the dungeon can
-- take the hard white rim light
-- while an edge against the figure
-- itself only steps up one value.

fig={}
for y=-1,128 do fig[y]={} end

-- how far the stencil runs in a
-- direction before it ends
function mar(x,y,dx,dy)
 for n=0,8 do
  x+=dx y+=dy
  if pget(x,y)!=stn then return n end
 end
 return 9
end

-- base = the form's own body value
function shade(x0,y0,x1,y1,base)
 local px,py,pc={},{},{}
 for y=y0,y1 do
  for x=x0,x1 do
   if pget(x,y)==stn then
    local u,d=mar(x,y,-1,-1),mar(x,y,1,1)
    local c=base
    if d==0 then
     c=0
    elseif u==0 then
     c=fig[y-1][x-1] and 6 or (dith(x,y,0.82) and 7 or 6)
    elseif u<=2 then
     c=6
    elseif d<=2 then
     c=base==0 and 0 or 5
    end
    add(px,x) add(py,y) add(pc,c)
   end
  end
 end
 -- the new form first, then a black
 -- contour bitten out of whatever
 -- was already under it: without
 -- this an arm laid over the cloak
 -- merges with the cloak s own rim
 -- light and stops reading as an
 -- arm at all.
 local cur={}
 for i=1,#px do cur[py[i]*128+px[i]]=true end
 for i=1,#px do
  local x,y=px[i],py[i]
  for dy=-1,1 do
   for dx=-1,1 do
    local nx,ny=x+dx,y+dy
    if fig[ny][nx] and not cur[ny*128+nx] then
     pset(nx,ny,0)
    end
   end
  end
 end
 for i=1,#px do
  pset(px[i],py[i],pc[i])
  fig[py[i]][px[i]]=true
 end
end
-->8
-- block font --
-----------------
-- 5x7 block font. seven rows, not
-- the usual five: at 3x5 the n has
-- no room for a diagonal and comes
-- out as an h, and k and r lose
-- their legs. each cell is a b x b
-- block, so b=3 gives a 15x21
-- letter.
--
-- lit by a flat drop shadow rather
-- than a per-cell emboss -- at 3px
-- a cell has no interior left once
-- both edges are lit, and the
-- shading eats the counters of a,
-- e and r.

fnt={}
fnt.s="01110100011000001110000011000101110"
fnt.t="11111001000010000100001000010000100"
fnt.a="01110100011000111111100011000110001"
fnt.c="01110100011000010000100001000101110"
fnt.k="10001100101010011000101001001010001"
fnt.r="11110100011000111110101001001010001"
fnt.u="10001100011000110001100011000101110"
fnt.n="10001110011100110101100111001110001"
fnt.e="11111100001000011110100001000011111"

function gw(g)
 return #g\7
end

function gat(g,x,y)
 local w=gw(g)
 if x<0 or x>=w or y<0 or y>6 then return false end
 return sub(g,y*w+x+1,y*w+x+1)=="1"
end

-- flat: every cell one colour
function word(s,ox,oy,b,gap,c)
 local x=ox
 for i=1,#s do
  local g=fnt[sub(s,i,i)]
  for ry=0,6 do
   for rx=0,gw(g)-1 do
    if gat(g,rx,ry) then
     rectfill(x+rx*b,oy+ry*b,x+rx*b+b-1,oy+ry*b+b-1,c)
    end
   end
  end
  x+=gw(g)*b+gap
 end
end

function wordw(s,b,gap)
 local w=(#s-1)*gap
 for i=1,#s do
  w+=gw(fnt[sub(s,i,i)])*b
 end
 return w
end

-- centred: 2px of black all round
-- so the letters lift off the
-- brickwork, then a hard grey
-- shadow down-right, then the
-- white face
function title(s,oy,b,gap)
 local ox=(128-wordw(s,b,gap))\2
 for dy=-2,2 do
  for dx=-2,2 do
   word(s,ox+dx,oy+dy,b,gap,0)
  end
 end
 word(s,ox+2,oy+2,b,gap,5)
 word(s,ox,oy,b,gap,7)
end

-->8
-- dungeon --
-----------------
cls(0)

-- 1. the back wall: 16x8 blocks in
--    an offset bond, mortar left as
--    the black gaps between them.
for by=0,12 do
 local y,off=by*8,(by%2)*8
 for bx=-1,8 do
  local x=bx*16+off
  rectfill(x,y,x+14,y+6,5)
  hl(x,x+14,y,6)
  line(x,y,x,y+6,6)
  local h=hsh(bx,by)
  if h<4 then
   -- a chipped corner or a crack:
   -- two blocks in five, never the
   -- same one twice
   pset(x+2+h,y+4,0)
   pset(x+3+h,y+5,0)
   pset(x+3+h,y+3,0)
  elseif h>13 then
   line(x+9,y+1,x+7,y+5,0)
  end
 end
end

-- 2. the arch: a way out, on the
--    far side of the room from the
--    torch. steps climb into it and
--    the light does not reach them.
rectfill(84,58,124,104,5)
circfill(104,58,20,5)
rectfill(88,58,120,104,0)
circfill(104,58,16,0)
-- only the jamb the torch can see
-- takes a lit edge
line(84,60,84,104,6)
for i=0,10 do
 local a=0.42+i/40
 pset(104+cos(a)*20,58+sin(a)*20,6)
 pset(104+cos(a)*19,58+sin(a)*19,6)
end
-- voussoirs
for i=0,6 do
 local a=0.5+i/12
 line(104+cos(a)*16,58+sin(a)*16,104+cos(a)*21,58+sin(a)*21,0)
end
for j=0,3 do
 hl(84,87,64+j*11,0)
 hl(121,124,69+j*11,0)
end
-- the stair inside it: the goal of
-- every floor of the game, climbing
-- away into the dark
for i=0,3 do
 local y,x0,x1=104-i*7,89+i*4,119-i*4
 rectfill(x0,y-6,x1,y,6)
 hl(x0,x1,y-6,i==0 and 7 or 6)
 hl(x0,x1,y-5,6)
 hl(x0,x1,y-1,0)
 hl(x0,x1,y,0)
end

-- 3. the floor, three courses of
--    flagstone, each one deeper
--    than the last
fry={104,110,118,128}
for r=1,3 do
 local y0,y1,w=fry[r],fry[r+1]-1,8+r*6
 rectfill(0,y0,127,y1,5)
 hl(0,127,y0-1,0)
 hl(0,127,y0,6)
 for i=-1,16 do
  local x=i*w+(r%2)*(w\2)
  line(x,y0,x,y1,0)
  line(x+1,y0+1,x+1,y1,6)
 end
end
hl(0,127,103,0)

-- 4. relight the room from the
--    torch, before the runner is
--    drawn so the dither never
--    crawls over him
relight()

-- 5. the bloom around the flame.
--    it only lifts stone that is
--    already lit -- promoting the
--    black mortar as well would
--    flatten the whole corner into
--    one grey field.
for y=26,90 do
 for x=0,48 do
  local dx,dy=(x-tox)/33,(y-toy+2)/31
  local d=sqrt(dx*dx+dy*dy)
  if d<1 and dith(x,y,(1-d)*1.3) and pget(x,y)==5 then
   pset(x,y,6)
  end
 end
end

-- 6. the sconce, bracketed to the
--    left wall. it is the light
--    source, so it goes on after
--    the relight and after the
--    bloom, at full value, instead
--    of being washed out by its own
--    glow.
rectfill(1,72,8,80,0)
rectfill(2,73,6,78,5)
hl(2,6,73,6)
line(2,73,2,78,6)
for i=0,6 do
 rectfill(6+i,74-i,9+i,78-i,0)
 rectfill(7+i,74-i,8+i,77-i,i<4 and 5 or 6)
end
ovalfill(8,61,20,71,0)
ovalfill(9,62,19,69,5)
hl(11,17,62,6)
line(9,63,9,67,6)
hl(10,18,70,0)

-- 7. the flame: a teardrop, widest
--    a third of the way up and
--    leaning off the wall, with a
--    solid white core. an oval here
--    reads as a light bulb.
--    (pico-8 sin runs backwards,
--    hence the minus.)
for y=48,66 do
 local t=(66-y)/18
 local w=-5.8*sin(0.5*t^0.85)
 local cx=tox+2.2*t*t
 for x=flr(cx-w),ceil(cx+w) do
  local u=abs(x-cx)/max(w,0.1)
  if u<=1 then
   pset(x,y,(u<0.55 or dith(x,y,1.9-u*1.9)) and 7 or 6)
  end
 end
end
-->8
-- the runner --
-----------------
-- a striding, hooded figure about
-- 62px tall -- roughly seven heads,
-- so he reads as a person rather
-- than as the game's 12x12 sprite
-- blown up. forms are laid down
-- back to front; each one is shaded
-- the moment it is drawn.

-- contact shadow first, so he is
-- standing on the floor and not
-- floating over it
for y=112,122 do
 for x=24,84 do
  local dx,dy=(x-54)/30,(y-119)/6
  if dx*dx+dy*dy<1 and dith(x,y,0.9) then pset(x,y,0) end
 end
end

-- cloak, trailing back to the left
for x=21,61 do
 local t=mid(0,(61-x)/40,1)
 local top=67+20*t*t
 local bot=110-30*t*t*t+3*sin(x/11)
 if bot>top then rectfill(x,top,x,bot,stn) end
end
shade(19,65,63,114,0)

-- far arm, swinging forward
limb(51,74,41,80,3.4,2.6,stn)
limb(41,80,43,70,2.6,2.2,stn)
circfill(43,68,2.9,stn)
shade(37,64,55,85,5)

-- rear leg, pushing off
limb(49,93,41,104,5,3.6,stn)
limb(41,104,35,115,3.6,2.6,stn)
limb(35,116,29,118,2.4,1.8,stn)
shade(26,89,54,121,5)

-- lead leg, planted forward
limb(57,93,64,105,5.4,3.8,stn)
limb(64,105,68,116,3.8,2.6,stn)
limb(68,117,76,118,2.6,2,stn)
shade(51,89,79,121,5)

-- torso: shoulders down to hips
limb(57,72,53,86,7.2,5.4,stn)
limb(53,86,52,94,5.4,6.2,stn)
shade(44,63,65,100,5)

-- head and hood
limb(51,59,43,69,4,1.2,stn)
circfill(56,62,6,stn)
circfill(55,66,4.6,stn)
shade(41,54,64,73,5)

-- near arm, swung back
limb(61,73,66,85,3.4,2.8,stn)
limb(66,85,66,95,2.8,2.2,stn)
circfill(66,97,2.6,stn)
shade(57,69,71,101,5)

-->8
-- his details --
-----------------
-- the face is a hole in the hood
-- with one lit cheek, which is all
-- the face a 62px figure needs and
-- all that survives at thumbnail
-- size.
-- the opening is the front of the
-- hood only: the cowl has to keep
-- some cloth on the back of his
-- head or it reads as a black ball
ovalfill(56,59,62,66,0)
hl(54,58,58,6)
pset(53,60,6)
-- the torch catches the brow, the
-- bridge of the nose and the chin;
-- the rest of the face stays in the
-- shadow of the hood
pset(62,60,6)
pset(62,61,7)
pset(61,62,7)
pset(61,63,6)
pset(60,64,6)
pset(59,65,6)
pset(58,64,5)
-- the collar, under the jaw
hl(53,59,68,0)
hl(54,60,69,5)

-- belt, and the strap across his
-- chest: two bright bands that cut
-- the tall dark shape into halves
hl(48,60,88,6)
hl(48,60,89,0)
pset(56,88,7)
for i=0,13 do
 pset(49+i,75+i*0.75,6)
end

-- the hem of the tunic
for x=46,62 do
 local y=93+2*sin(x/9)
 pset(x,y,6)
 pset(x,y+1,0)
end

-- boot cuffs, so the feet are feet
-- and not the end of the leg
hl(31,38,113,6)
hl(31,38,114,0)
hl(65,72,114,6)
hl(65,72,115,0)

-- vignette: pull the corners down
-- so the title and the figure hold
-- the eye at 1x
for y=0,127 do
 for x=0,127 do
  local dx,dy=(x-54)/78,(y-68)/80
  local d=sqrt(dx*dx+dy*dy)
  if d>0.66 then
   local c=pget(x,y)
   if dith(x,y,(d-0.66)*1.7) then c=dn(c) end
   if dith(x,y,(d-0.66)*1.7-0.9) then c=dn(c) end
   pset(x,y,c)
  end
 end
end

-- the logo goes on last so nothing
-- dithers over it
title("stack",2,3,2)
title("runner",25,3,2)

-- safety net: nothing outside the
-- 0/5/6/7 palette may survive into
-- the label
local bad=0
for y=0,127 do
 for x=0,127 do
  local c=pget(x,y)
  if c!=0 and c!=5 and c!=6 and c!=7 then
   bad+=1
   pset(x,y,5)
  end
 end
end
printh("offpalette="..bad)
-->8
-- dump --
-----------------
-- the sheet is the same 128x128 as
-- the screen, so one memcpy puts a
-- hand-painted cover in front of
-- whatever the code composed.
if sheet then
 memcpy(0x6000,0x0,0x2000)
end

printh("@@begin")
for y=0,127 do
 local s=""
 for x=0,127 do
  local c=pget(x,y)
  s=s..sub(hx,c+1,c+1)
 end
 printh(s)
end
printh("@@end")
extcmd("shutdown")
