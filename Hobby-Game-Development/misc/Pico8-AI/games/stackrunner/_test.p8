pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- stack runner
-- by roberto freire

-- globals --
-----------------
bw=10 bh=9
nlv=16
mode=0 lv=1
g={} mv={} it={} sav={} hist={}
px=0 py=0 fx=1 fy=0
-- walk animation. wx/wy is the
-- path the last move traced,
-- wi the segment being drawn,
-- wf the frame inside it. the
-- board only reacts once the
-- walk is over, via wcb.
wx={} wy={} wi=0 wf=0 wcb=nil
wsp=3
-- where this floor was entered
spx=0 spy=0
-- a push moves the crate in
-- the model at once, but it is
-- drawn one cell behind the
-- player: pbx,pby is where the
-- crate stood, pbs the walk
-- segment that shoves it,
-- pbn how many shoves, pdx/pdy
-- the direction
pbx=0 pby=0 pbs=0 pbn=0
pdx=0 pdy=0
bfuse=0 shake=0 tk=0
-- guard telegraph: ph frames of
-- blink, then the kill lands
ph=0
msg="" mt=0
-- the run is stuck: arrows
-- pressed with an empty move
-- stack. blocks the board
-- until 🅾️ rewinds us out.
stuck=false
-- set on every screen change:
-- swallows input until 🅾️ and ❎
-- are both released, so btnp's
-- auto-repeat can't carry a
-- held button into the next
-- screen
lk=0
-- frames of dead air after a
-- step back down a floor: the
-- board is frozen so a 🅾️ held
-- a beat too long cannot chain
-- into a second floor. lk takes
-- over when it runs out, so the
-- button has to be released
-- before anything else counts
pz=0
backreq=false rstreq=false
dx={-1,1,0,0}
dy={0,0,-1,1}
-- cells that stop a step
solid={["#"]=1,["-"]=1,["2"]=1,["*"]=1}
-- movement cards -> steps
stp={a=1,b=2,c=3,d=99}
-- cell char -> tile index
tix={["."]=0,["#"]=1,o=2,["-"]=3,["="]=4,["^"]=5,
     ["2"]=7,["*"]=8,
     a=9,b=10,c=11,d=12,x=13,y=14}
-- player tiles by facing:
-- left, right (the left art
-- flipped), up, down. +1/+2
-- are that facing's two walk
-- frames.
psb={30,30,33,15}
-- levels live in the map sheet:
-- one 16x16 block per level,
-- 8 blocks per map row, only
-- the top-left 10x9 is played.
-- map tile 0 is floor, every
-- other tile is 47+n, indexing
-- this string for its cell char
-- (sprites 48..61 are the
-- matching editor icons).
mchr="#o-=^2abcdxyp"
-- tutorial rows: tile, caption
tut1={5,9,10,12,2,13,14}
tut2=split("reach the stair,cards = steps you spend,newest card spent first,max card: run til blocked,push boxes into free floor,bomb blasts the next cell,switch flips every door")

-->8
-- entry point --
-----------------
function _init()
 palt(0,false)
 palt(14,true)
 -- calm dungeon loop on ch 0-2;
 -- ch 3 is left free for sfx
 music(0,0,7)
 menuitem(1,"back a level",function() backreq=true end)
 menuitem(2,"restart level",function() rstreq=true end)
end

function begingame()
 mode=1 lv=1 lk=1
 mv={"b","c","b"} it={} sav={}
 loadlv(1,true)
end

-- fresh means we arrived from
-- the floor above, so the
-- entry stacks are re-saved
function loadlv(n,fresh)
 lv=n
 if fresh or not sav[n] then
  sav[n]={cp(mv),cp(it)}
 end
 mv=cp(sav[n][1])
 it=cp(sav[n][2])
 g={}
 -- the map keeps the player
 -- start; we only read it, so
 -- it survives every restart
 local ox,oy=(n-1)%8*16,(n-1)\8*16
 for i=1,bw*bh do
  local x,y=(i-1)%bw,(i-1)\bw
  local v=mget(ox+x,oy+y)
  local c="."
  if v>0 then c=sub(mchr,v-47,v-47) end
  if c=="p" then
   px=x py=y
   spx=x spy=y
   c="."
  end
  g[i]=c
 end
 fx=1 fy=0
 bfuse=0 ph=0 wi=0 pbn=0
 stuck=false
 hist={}
end

function nextlv()
 sfx(6)
 if lv>=nlv then
  mode=2 return
 end
 loadlv(lv+1,true)
 flash("floor "..lv)
end

function backlv()
 if lv>1 then
  loadlv(lv-1,false)
  pz=15
  flash("floor "..lv)
 end
end

-- the modal is closed. there
-- is no move that can save the
-- run, so we take it backwards
-- for the player instead of
-- asking them to find undo:
-- rewind until there is a card
-- to spend again, and if the
-- floor was entered with none,
-- drop back to the one before.
function unstick()
 while #mv<1 and #hist>0 do
  undo()
 end
 if #mv<1 then
  if lv>1 then
   backlv()
  else
   loadlv(1,false)
   flash("floor 1")
  end
 end
end

function die()
 sfx(5) shake=8
 loadlv(lv,false)
 flash("caught!")
end

function flash(s)
 msg=s mt=45
end

-->8
-- grid --
-----------------
function gat(x,y)
 if x<0 or y<0 or x>=bw or y>=bh then
  return "#"
 end
 return g[y*bw+x+1]
end

function gset(x,y,c) g[y*bw+x+1]=c end

function cp(t)
 local r={}
 for v in all(t) do add(r,v) end
 return r
end

function snap()
 local s=""
 for i=1,bw*bh do s=s..g[i] end
 add(hist,{s,px,py,cp(mv),cp(it),bfuse,fx,fy})
end

function undo()
 local h=hist[#hist]
 if not h then
  -- nothing left to rewind on
  -- this floor, so the only
  -- step back is the floor
  -- itself. the ring on the
  -- floor marks the cell where
  -- that becomes true.
  if lv>1 then backlv() else sfx(3) end
  return
 end
 deli(hist)
 for i=1,bw*bh do
  g[i]=sub(h[1],i,i)
 end
 px=h[2] py=h[3]
 mv=h[4] it=h[5] bfuse=h[6]
 fx=h[7] fy=h[8]
 sfx(7)
end

-- one more cell of walk path
function wadd()
 add(wx,px) add(wy,py)
end

-- play the path back, then run
-- cb with the move finished
function wgo(cb)
 wi=1 wf=0 wcb=cb
end

-- grab whatever is on x,y --
-- called from the walk as the
-- player passes over the cell,
-- so pickups leave the grid one
-- at a time, in step
function pick(x,y)
 local c=gat(x,y)
 if stp[c] then
  if #mv<5 then
   add(mv,c) gset(x,y,".") sfx(1)
  end
 elseif c=="x" or c=="y" then
  if #it<3 then
   add(it,c) gset(x,y,".") sfx(1)
  end
 end
end

-->8
-- rules --
-----------------
-- one square. false when
-- something stopped us.
function step(vx,vy)
 local nx,ny=px+vx,py+vy
 local c=gat(nx,ny)
 if solid[c] then return false end
 if c=="o" then
  if gat(nx+vx,ny+vy)!="." then
   return false
  end
  gset(nx+vx,ny+vy,"o")
  gset(nx,ny,".")
  if pbn<1 then
   pbx=nx pby=ny pbs=#wx
   pdx=vx pdy=vy
  end
  pbn+=1
 end
 px=nx py=ny
 return true
end

function domove(b)
 if #mv<1 then
  sfx(3) stuck=true
  return
 end
 snap()
 pbn=0
 local n=mv[#mv]
 deli(mv)
 -- a card is only spent when
 -- we actually leave the cell
 wx={px} wy={py}
 if not step(dx[b+1],dy[b+1]) then
  add(mv,n) deli(hist) sfx(3)
  return
 end
 wadd()
 fx=dx[b+1] fy=dy[b+1]
 sfx(0)
 for i=2,stp[n] do
  if gat(px,py)=="^" then break end
  if not step(fx,fy) then break end
  wadd()
 end
 wgo(settle)
end

function useit()
 if #it<1 then sfx(3) return end
 local i=it[#it]
 -- the bomb lands one square
 -- ahead of us
 local tx,ty=px+fx,py+fy
 if i=="x" and gat(tx,ty)!="." then
  sfx(3) flash("no room to throw")
  return
 end
 snap()
 deli(it)
 sfx(2)
 if i=="x" then
  gset(tx,ty,"*")
  bfuse=1
 else
  for k=1,bw*bh do
   if g[k]=="-" then g[k]="="
   elseif g[k]=="=" then g[k]="-" end
  end
 end
end

-- resolves once a move is over
function settle()
 if bfuse==1 then
  bfuse=0
  boom()
 end
 endturn()
end

-- the stair beats the guard
function endturn()
 if gat(px,py)=="^" then
  nextlv() return
 end
 for d=1,4 do
  if gat(px+dx[d],py+dy[d])=="2" then
   -- freeze the board for a
   -- second and blink the
   -- player, so you see who has
   -- you before it happens
   ph=30 sfx(3) return
  end
 end
end

function boom()
 sfx(4) shake=8
 for y=0,bh-1 do
  for x=0,bw-1 do
   if gat(x,y)=="*" then
    gset(x,y,".")
    for d=1,4 do
     local c=gat(x+dx[d],y+dy[d])
     if c=="o" or c=="2" then
      gset(x+dx[d],y+dy[d],".")
     end
    end
   end
  end
 end
end

-->8
-- update --
-----------------
function _update()
 tk+=1
 if shake>0 then shake-=1 end
 if mt>0 then mt-=1 end

 if lk>0 then
  if not (btn(4) or btn(5)) then
   lk=0
  end
  return
 end
 if pz>0 then
  pz-=1
  if pz<=0 then lk=1 end
  return
 end
 if mode==0 then
  if btnp(5) then begingame() end
  if btnp(4) then mode=3 lk=1 end
  return
 end
 if mode==3 then
  if btnp(4) or btnp(5) then
   mode=0 lk=1
  end
  return
 end
 if mode==2 then
  if btnp(5) then mode=0 lk=1 end
  return
 end

 -- the walk plays out in full
 -- before the board reacts
 if wi>0 then
  wf+=1
  if wf>=wsp then
   wf=0 wi+=1
   pick(wx[wi],wy[wi])
   if wi>=#wx then
    wi=0 wcb()
   end
  end
  return
 end
 -- input is locked out while
 -- an enemy telegraphs
 if ph>0 then
  ph-=1
  if ph<=0 then die() end
  return
 end
 if backreq then
  backreq=false backlv() return
 end
 if rstreq then
  rstreq=false loadlv(lv,false) return
 end
 -- nothing but the way out is
 -- allowed while we are stuck
 if stuck then
  -- rewind, and only rewind:
  -- the modal closes with the
  -- same button that undoes,
  -- so there is nothing new to
  -- learn and nothing else to
  -- press by mistake
  if btnp(4) then
   stuck=false lk=1
   unstick()
  end
  return
 end
 for b=0,3 do
  if btnp(b) then domove(b) return end
 end
 if btnp(5) then useit() return end
 if btnp(4) then undo() end
end

-->8
-- draw --
-----------------
-- v=7 whites a sprite out, nil
-- puts the palette back
-- (leaves palt alone)
function ppal(v)
 for c=0,15 do pal(c,v or c) end
end

-- a pushed crate slides out of
-- its cell only once the walk
-- reaches the cell in front of
-- it, so the player is touching
-- it the whole way. returns the
-- draw position plus the grid
-- cell to leave blank.
function boxlag()
 if pbn<1 or wi<1 then return end
 local k=mid(wi-pbs,0,pbn)
 if k>=pbn then return end
 local u=0
 if wi>=pbs then u=wf/wsp end
 return pbx+(k+u)*pdx,pby+(k+u)*pdy,
        pbx+pbn*pdx,pby+pbn*pdy
end

function dtile(i,x,y,f)
 sspr(i%10*12,i\10*12,12,12,x,y,12,12,f)
end

function _draw()
 cls(0)
 if mode==0 then intro() return end
 if mode==3 then tut() return end
 if mode==2 then outro() return end

 camera()
 if shake>0 then
  camera(-1+rnd(3),-1+rnd(3))
 end
 local bx,by,hx,hy=boxlag()
 for y=0,bh-1 do
  for x=0,bw-1 do
   local c=g[y*bw+x+1]
   if c=="o" and x==hx and y==hy then
    c="."
   end
   local sx,sy=4+x*12,4+y*12
   -- one of four slabs, or one
   -- of four courses of the
   -- same brick. hashed off the
   -- cell so it never flickers
   -- and rewinds redraw the
   -- same floor.
   local v=(x*3+y*7+x*y+lv)%4
   if c=="#" then
    dtile(44+v,sx,sy)
   else
    dtile(40+v,sx,sy)
    if c!="." then dtile(tix[c],sx,sy) end
   end
  end
 end
 -- the cell the floor started
 -- on: standing here means
 -- there is nothing to rewind
 -- and o drops a floor
 circ(9+spx*12,9+spy*12,4,6)
 if bx then dtile(2,4+bx*12,4+by*12) end
 -- where a thrown bomb lands
 if it[#it]=="x" and wi<1 and tk%16<10 then
  local tx,ty=px+fx,py+fy
  if gat(tx,ty)=="." then
   rect(4+tx*12,4+ty*12,15+tx*12,15+ty*12,7)
  end
 end
 -- slide along the walk path,
 -- swapping the two walk
 -- frames once per cell
 local ax,ay,f=px,py,0
 if wi>0 then
  local u=wf/wsp
  ax=wx[wi]+(wx[wi+1]-wx[wi])*u
  ay=wy[wi]+(wy[wi+1]-wy[wi])*u
  f=1+wi%2
 end
 local d=4
 if fy==0 then
  d=fx<0 and 1 or 2
 elseif fy<0 then d=3 end
 local wh=ph>0 and ph%8<4
 if wh then ppal(7) end
 dtile(psb[d]+f,4+ax*12,4+ay*12,d==2)
 if wh then ppal() end
 camera()

 if mt>0 then
  local w=#msg*4
  rectfill(61-w\2,50,67+w\2,60,0)
  rect(61-w\2,50,67+w\2,60,7)
  print(msg,64-w\2,53,7)
 end
 if stuck then stuckbox() end
 hud()
end

-- blocking version of flash:
-- stays up until 🅾️ closes
-- it, and says which way out
-- it is about to take
function stuckbox()
 rectfill(24,48,103,72,0)
 rect(24,48,103,72,7)
 print("no moves left",38,53,7)
 if tk%16<10 then
  local s=#hist>0 and "🅾️ rewind" or "🅾️ back a floor"
  print(s,64-(#s*4+4)\2,63,6)
 end
end

function hud()
 rectfill(0,112,127,127,0)
 line(0,112,127,112,5)
 for i=1,5 do
  local x=2+(i-1)*12
  if mv[i] then
   dtile(tix[mv[i]],x,114)
  else
   rect(x+3,118,x+7,122,5)
  end
 end
 print("|",64,117,6)
 for i=1,3 do
  local x=68+(i-1)*12
  if it[i] then
   dtile(tix[it[i]],x,114)
  else
   rect(x+3,118,x+7,122,5)
  end
 end
 -- the top of each stack is
 -- what gets spent next
 if tk%16<10 then
  if #mv>0 then
   rect(2+(#mv-1)*12,114,13+(#mv-1)*12,125,7)
  end
  if #it>0 then
   rect(68+(#it-1)*12,114,79+(#it-1)*12,125,7)
  end
 end
 -- right aligned so a two
 -- digit floor still fits
 local n=lv.."/"..nlv
 print(n,126-#n*4,117,6)
end

function intro()
 for i=0,9 do
  dtile(44+i%4,i*12+4,0)
  dtile(44+(i+2)%4,i*12+4,104)
 end
 rectfill(0,24,127,96,0)
 rect(0,24,127,96,6)
 print("stack",8,32,7)
 print("runner",8,40,7)
 dtile(9,92,28)
 dtile(11,106,28)
 dtile(12,92,42)
 dtile(13,106,42)
 print("sixteen floors. every step",6,58,6)
 print("costs a card you found.",6,64,6)
 if tk%32<20 then
  print("❎ play",8,80,7)
 end
 print("🅾️ how to play",56,80,6)
end

-- one screen of rules, reached
-- from the title with 🅾️
function tut()
 print("how to play",42,4,7)
 for i=1,7 do
  local y=14+(i-1)*12
  dtile(tut1[i],4,y)
  print(tut2[i],20,y+4,6)
 end
 dtile(7,26,98)
 print("kills anything that",42,100,6)
 print("stops next to it",42,106,6)
 print("⬅️➡️⬆️⬇️spend ❎item 🅾️undo",4,113,6)
 print("❎🅾️ back",44,121,7)
end

function outro()
 rectfill(0,40,127,84,0)
 rect(0,40,127,84,6)
 print("you escaped",34,52,7)
 print("all "..nlv.." floors",36,62,7)
 if tk%32<20 then
  print("❎",62,74,7)
 end
end

