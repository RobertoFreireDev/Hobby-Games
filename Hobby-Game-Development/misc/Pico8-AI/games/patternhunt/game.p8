__lua__
-- pattern hunt
-- by roberto freire

hue={8,9,11,12,13,14}
gx=4 gy=5
tx=62 ty=115
w2="\^w\^t"

function _init()
 -- 8-way neighbours of every cell,
 -- as a list and as a lookup
 nbc={} nbm={}
 for i=1,110 do
  local o={}
  local m={}
  local c=(i-1)%11
  local r=(i-1)\11
  for dy=-1,1 do
   for dx=-1,1 do
    local x=c+dx
    local y=r+dy
    if (dx!=0 or dy!=0)
     and x>=0 and x<11
     and y>=0 and y<10 then
     local b=y*11+x+1
     add(o,b) m[b]=true
    end
   end
  end
  nbc[i]=o nbm[i]=m
 end
 pc=split"30,22,98,22,98,22,98,70,98,70,30,70,30,70,30,22,36,28,92,28,92,28,92,62,92,62,36,62,36,62,36,28,40,36,74,36,40,42,82,42,40,48,66,48,88,66,92,66,92,66,92,68,92,68,88,68,88,68,88,66,56,70,56,80,72,70,72,80,46,80,82,80,82,80,82,86,82,86,46,86,46,86,46,80,64,86,64,94,30,94,98,94,98,94,106,106,106,106,22,106,22,106,30,94,30,98,98,98,27,102,101,102"
 sn=#pc\4
 mksh()
 st=0 it=0
 sfx(11,3)
end

-->8
-- patterns and grid

-- three digits are a pattern when
-- they are all equal (f=1), are
-- three consecutive digits in any
-- order (f=2), or share one hue
-- (f=3).  f=1 implies f=3.
function vok(a,b,c,f)
 if f==3 then
  return a%6==b%6 and b%6==c%6
 end
 local l=min(a,min(b,c))
 local h=max(a,max(b,c))
 if f==1 then return l==h end
 return h-l==2 and a!=b and a!=c and b!=c
end

-- every filled 8-connected triple
-- through i that matches f.  lo
-- keeps only the triples i is the
-- lowest cell of, so a grid-wide
-- sweep counts each one once.
function tri(i,f,lo)
 local o={}
 local n=nbc[i]
 for j=1,#n do
  local b=n[j]
  if g[b]>=0 and (not lo or b>i) then
   -- b and c both touch i
   for k=j+1,#n do
    local c=n[k]
    if g[c]>=0 and (not lo or c>i)
     and vok(g[i],g[b],g[c],f) then
     add(o,{i,b,c})
    end
   end
   -- c hangs off b only
   for c in all(nbc[b]) do
    if c!=i and g[c]>=0
     and not nbm[i][c]
     and (not lo or c>i)
     and vok(g[i],g[b],g[c],f) then
     add(o,{i,b,c})
    end
   end
  end
 end
 return o
end

-- every instance of f in the grid
function scan(f)
 local r={}
 for i=1,110 do
  if g[i]>=0 then
   for o in all(tri(i,f,true)) do
    add(r,o)
   end
  end
 end
 return r
end

-- would i complete any pattern?
-- f=3 subsumes f=1, so two sweeps
-- cover all three families
function hit(i)
 return #tri(i,2)+#tri(i,3)>0
end

-- a digit for i that completes
-- nothing; false if there is none
function fill(i)
 local c={}
 for v=0,9 do
  add(c,v,flr(rnd(#c+1))+1)
 end
 for v in all(c) do
  g[i]=v
  if not hit(i) then return true end
 end
 g[i]=-1
 return false
end

-- free for group id: unclaimed and
-- touching no other group, so two
-- instances can never end up
-- adjacent
function fre(i,id)
 if gi[i] then return false end
 for b in all(nbc[i]) do
  if gi[b] and gi[b]!=id then return false end
 end
 return true
end

-- grow one 8-connected 3-cell group
-- and give it the digits of family f
function seed(f,id)
 for a=1,30 do
  local i=flr(rnd(110))+1
  if fre(i,id) then
   local o={i}
   gi[i]=id
   while #o<3 do
    local cd={}
    for c in all(o) do
     for b in all(nbc[c]) do
      if fre(b,id) then add(cd,b) end
     end
    end
    if #cd<1 then break end
    local b=cd[flr(rnd(#cd))+1]
    gi[b]=id add(o,b)
   end
   if #o==3 then
    local d
    if f==1 then
     local v=flr(rnd(10))
     d={v,v,v}
    elseif f==2 then
     local v=flr(rnd(8))
     d={v,v+1,v+2}
    else
     -- one hue, never all equal
     local v=flr(rnd(4))
     d={v,v+6,v+flr(rnd(2))*6}
    end
    for j=1,3 do
     local k=flr(rnd(#d))+1
     g[o[j]]=d[k] deli(d,k)
    end
    return true
   end
   for c in all(o) do gi[c]=nil end
  end
 end
end

-- one family per round, drawn at
-- random, so every pattern on the
-- board follows the same rule
function gen()
 for a=1,10 do
  tr=flr(rnd(3))+1
  g={} gi={}
  for i=1,110 do g[i]=-1 end
  local gd=true
  for j=1,6 do
   if not seed(tr,j) then gd=false end
  end
  -- filler never completes a pattern
  -- of any family, so the seeded
  -- groups stay the only instances
  for i=1,110 do
   if g[i]<0 then
    if not fill(i) then
     g[i]=flr(rnd(10)) gd=false
    end
   end
  end
  tot=#scan(tr)*3
  if gd and tot==18 then return end
 end
end

-->8
-- play

function newround()
 gen()
 cur=61 sel={} ss={}
 got=0
 fl={} fk=0 hd={0,0,0,0}
 flash=0 pop=0 rv=0
 idle=0 st=1
 -- the bed is a 64s loop: let it
 -- run on across rounds, and only
 -- restart if it stopped or the
 -- tense bank is still up
 if tense or stat(24)<0 then
  music(0,0,7)
 end
 tense=false
 sfx(9,3)
end

-- step one cell, skipping over any
-- cell already resolved, and stay
-- put if the rest of that row or
-- column is empty
function mv(b)
 local i=cur
 while true do
  local c=(i-1)%11
  local r=(i-1)\11
  if b==0 and c>0 then i-=1
  elseif b==1 and c<10 then i+=1
  elseif b==2 and r>0 then i-=11
  elseif b==3 and r<9 then i+=11
  else return end
  if g[i]>=0 then
   cur=i sfx(0,3,(i-1)\11,1)
   return
  end
 end
end

-- the cursor never rests on a
-- resolved cell: after a clear it
-- hops to the closest live one
function fix()
 if g[cur]>=0 then return end
 local bd=99
 local bi
 for i=1,110 do
  if g[i]>=0 then
   local d=abs((i-1)%11-(cur-1)%11)
    +abs((i-1)\11-(cur-1)\11)
   if d<bd then bd=d bi=i end
  end
 end
 if bi then cur=bi end
end

function tog()
 if g[cur]<0 then return end
 if ss[cur] then
  ss[cur]=nil del(sel,cur)
  sfx(2,3,min(#sel,7),1)
 elseif #sel<3 then
  ss[cur]=true add(sel,cur)
  sfx(1,3,#sel-1,1)
 else
  sfx(10,3)
 end
end

-- is the selection 3 live cells,
-- 8-connected, matching a family?
-- only the round's own family can
-- match, since the filler completes
-- none of them
function inst()
 if #sel!=3 then return false end
 local a,b,c=sel[1],sel[2],sel[3]
 if g[a]<0 or g[b]<0 or g[c]<0 then
  return false
 end
 local e=0
 if nbm[a][b] then e+=1 end
 if nbm[a][c] then e+=1 end
 if nbm[b][c] then e+=1 end
 if e<2 then return false end
 return vok(g[a],g[b],g[c],2)
  or vok(g[a],g[b],g[c],3)
end

function lost()
 st=3 pop=0
 music(-1,20)
 sfx(6,3)
end

function clr()
 local k=0
 for i=1,110 do
  if ss[i] then
   add(fl,{
    x=gx+((i-1)%11)*11+2,
    y=gy+((i-1)\11)*11+1,
    d=g[i],f=-k*5,l=(k%2)*2-1})
   g[i]=-1 k+=1
  end
 end
 sel={} ss={} fk=0 idle=0
 fix()
 if tense then
  tense=false
  music(mid(0,stat(24)-8,7),400,7)
 end
end

function subm()
 if #sel<3 then return end
 sfx(3,3)
 if not inst() then lost() return end
 -- the round's first group is the
 -- one that proves the rule
 if got==0 then sfx(5,3) end
 clr()
end

function uplay()
 if rv<110 then rv+=5 return end
 if st>1 then
  if btnp(5) then newround() end
  return
 end
 for f in all(fl) do
  f.f+=1
  if f.f>=26 then
   got+=1 flash=4 pop=2
   sfx(4,3,min(fk,7),1) fk+=1
   del(fl,f)
  end
 end
 if flash>0 then flash-=1 end
 if pop>0 then pop-=1 end
 if #fl>0 then return end
 if tot>0 and got>=tot then
  st=2 pop=0
  music(-1,30) sfx(7,3)
  return
 end
 for b=0,3 do
  if btn(b) then
   hd[b+1]+=1
   local h=hd[b+1]
   if h==1 or (h>8 and h%3==0) then mv(b) end
  else
   hd[b+1]=0
  end
 end
 if btnp(5) then tog() end
 if btnp(4) then subm() end
 idle+=1
 if idle==900 and not tense then
  tense=true
  music(mid(0,stat(24),7)+8,400,7)
 end
end

function _update()
 it+=1
 if st==0 then
  if btnp(5) then
   if it<sn*3 then it=sn*3 else newround() end
  end
  -- the post beep lands on the frame
  -- the wireframe finishes, skipped
  -- or not
  if st==0 and it==sn*3 then
   sfx(12,3)
  end
  if btnp(4) then
   st=4 tp=1 tt=0
   sfx(1,3,0,1)
  end
 elseif st==4 then
  utut()
 else
  uplay()
 end
end

-->8
-- draw

function dintro()
 local q=min(it/3,sn)
 for j=1,sn do
  local a=(j-1)*4
  local f=mid(q-j+1,0,1)
  if f>0 then
   local x=pc[a+1]
   local y=pc[a+2]
   line(x,y,
    x+(pc[a+3]-x)*f,
    y+(pc[a+4]-y)*f,
    q>=sn and 13 or hue[(j-1)%6+1])
  end
 end
 print("pattern hunt",40,8,13)
 print("find sets of 3",36,15,6)
 if q>=sn then
  print("🅾️ how to play",36,111,6)
  print("❎ start",48,119,7)
 end
end

function dgrid()
 for i=1,min(rv,110) do
  local v=g[i]
  local x=gx+((i-1)%11)*11
  local y=gy+((i-1)\11)*11
  if v<0 then
   pset(x+5,y+5,5)
  else
   local c=hue[v%6+1]
   local u=i==cur and st==1
   if ss[i] then
    if u then
     rectfill(x+1,y,x+9,y+10,c)
     print(w2..v,x+2,y+1,0)
    else
     rectfill(x+2,y+1,x+8,y+9,c)
     print(v,x+4,y+3,0)
    end
   elseif u then
    print(w2..v,x+2,y+1,c)
   else
    print(v,x+4,y+3,c)
   end
  end
 end
end

function dfly()
 for f in all(fl) do
  if f.f>=0 then
   local p=f.f/26
   local e=1-(1-p)^3
   local c=hue[f.d%6+1]
   local x=f.x+(tx-f.x)*e-sin(p*.5)*9*f.l
   local y=f.y+(ty-f.y)*e
   if p<.5 then
    print(w2..f.d,x,y,c)
   else
    print(f.d,x+1,y+2,c)
   end
  end
 end
end

function dhud()
 line(0,1,127,1,13)
 line(0,120,127,120,13)
 local c=7
 if st==2 then c=11
 elseif st==3 then c=8
 elseif flash>0 then c=14 end
 rectfill(0,116,127,122,0)
 if st>1 then
  local m=st==2 and "solved! ❎ new grid"
   or "wrong! ❎ new grid"
  print(m,64-(#m*4+4)\2,117,c)
 else
  local s=flr(got*100/max(tot,1)+.5).."%"
  local w=(pop>0 and #s*8 or #s*4)-1
  print(pop>0 and "\^w"..s or s,64-w\2,117,c)
 end
end

function _draw()
 cls()
 if st==0 then
  dintro()
 elseif st==4 then
  dtut()
 else
  dgrid() dfly() dhud()
 end
end
-->8
-- tutorial

pl=split"equals,1 delta,same hue"
ps=split"three of a kind,a run in any order,three of a colour"
pd=split"7,7,7,5,3,4,3,9,9"

-- every distinct 3-cell chain, up
-- to translation: a hinge plus two
-- of its neighbours, deduped on a
-- 3x3 bitmask and centred in the
-- box.  20 of them, and the same
-- silhouettes inst() accepts.
function mksh()
 local d={}
 for y=-1,1 do
  for x=-1,1 do
   if x!=0 or y!=0 then add(d,{x,y}) end
  end
 end
 sh={}
 local sd={}
 for j=1,8 do
  for k=j+1,8 do
   local u,v=d[j],d[k]
   local p={{0,0},{u[1],u[2]},{v[1],v[2]}}
   local ax,ay=1,1
   for c in all(p) do
    ax=min(ax,c[1]) ay=min(ay,c[2])
   end
   local bx,by,m=0,0,0
   for c in all(p) do
    c[1]-=ax c[2]-=ay
    bx=max(bx,c[1]) by=max(by,c[2])
    m|=1<<(c[2]*3+c[1])
   end
   if not sd[m] then
    sd[m]=true
    local ox,oy=(2-bx)\2,(2-by)\2
    for c in all(p) do
     c[1]+=ox c[2]+=oy
    end
    -- a hinge and its opposite is a
    -- straight run; three cells in a
    -- 2x2 are a block; the rest bend
    p.n="bend"
    if u[1]==-v[1] and u[2]==-v[2] then
     p.n="line"
    elseif bx==1 and by==1 then
     p.n="block"
    end
    add(sh,p)
   end
  end
 end
end

function utut()
 tt+=1
 if btnp(0) or btnp(1) then
  tp=3-tp tt=0
  sfx(0,3,4,1)
 end
 if btnp(4) then
  -- back to a finished wireframe
  st=0 it=sn*3
  sfx(2,3,0,1)
 end
end

-- page 1: the shapes, drawn in one
-- every 3 frames, then a highlight
-- walking the gallery
function dshp()
 print("shapes",52,6,7)
 print("three cells in a chain,",18,15,6)
 print("diagonals count",34,22,6)
 local hi=0
 if tt>#sh*3 then hi=tt\14%#sh+1 end
 for j=1,min(tt\3,#sh) do
  local x=10+(j-1)%7*16
  local y=34+(j-1)\7*17
  if j==hi then rectfill(x-2,y-2,x+13,y+13,1) end
  -- a dot in every cell of the box,
  -- so a shape reads against its own
  -- 3x3 and not its neighbour's
  for a=0,2 do
   for b=0,2 do
    pset(x+a*4+1,y+b*4+1,j==hi and 5 or 1)
   end
  end
  for c in all(sh[j]) do
   local u,v=x+c[1]*4,y+c[2]*4
   rectfill(u,v,u+2,v+2,j==hi and 7 or 13)
  end
 end
 if hi>0 then
  local n=sh[hi].n
  print(n,64-#n*2,88,7)
 end
 print(#sh.." shapes in all",32,96,6)
end

-- page 2: the three rules, each
-- picked up a cell at a time and
-- flashed, the way a real group
-- goes down
function dpat()
 print("patterns",48,6,7)
 print("a chain counts when its",18,15,6)
 print("three digits are...",28,22,6)
 local q=tt%64
 local ns=mid(q\10,0,3)
 for r=1,3 do
  local y=34+(r-1)*24
  print(pl[r],6,y,7)
  print(ps[r],6,y+7,6)
  for i=1,3 do
   local v=pd[(r-1)*3+i]
   local x=78+(i-1)*11
   local c=hue[v%6+1]
   if q>=44 then
    rectfill(x+1,y-1,x+9,y+9,
     q%4<2 and 7 or c)
    print(v,x+4,y+2,0)
   elseif i<=ns then
    rectfill(x+2,y,x+8,y+8,c)
    print(v,x+4,y+2,0)
   else
    print(v,x+4,y+2,c)
   end
  end
 end
 print("colours repeat every 6",20,104,6)
 for v=0,9 do
  print(v,34+v*6,111,hue[v%6+1])
 end
end

function dtut()
 if tp==1 then dshp() else dpat() end
 print("⬅️➡️ page",26,120,6)
 print("🅾️ back",74,120,6)
end

