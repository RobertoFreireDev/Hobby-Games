pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- labelgen for snakebox
-- throwaway cover-art generator: draws the 128x128 label with plain
-- drawing calls (no spr, no sprite sheet), then dumps it as hex.

hx="0123456789abcdef"
bay={0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5}
dith_12=0b1000000000100000
dith_25=0b1010000010100000
dith_50=0b1010010110100101

function dith(x,y,k)
 return k*16>bay[(y%4)*4+(x%4)+1]
end

function oprint(s,x,y,c)
 for dx=-1,1 do
  for dy=-1,1 do
   print(s,x+dx,y+dy,0)
  end
 end
 print(s,x,y,c)
end
-->8
-- block title font: 4x5 cells at cs px each, adv px between glyph origins.
-- cs was 4 while the title was "snake": eight letters do not fit a 128px
-- cover at that size (8*18-2 = 142), so the cell dropped to 3 and the
-- advance to 14, which puts "snakebox" in 110px. everything else about the
-- font is unchanged -- the glyphs are still 4 cells wide, so their holes are
-- still 2 cells, which is what keeps them open under the halo below
cs,adv=3,14

glyph={}
glyph["s"]={"0111","1000","0110","0001","1110"}
glyph["n"]={"1001","1101","1111","1011","1001"}
glyph["a"]={"0110","1001","1111","1001","1001"}
glyph["k"]={"1001","1010","1100","1010","1001"}
glyph["e"]={"1111","1000","1110","1000","1111"}
glyph["b"]={"1110","1001","1110","1001","1110"}
glyph["o"]={"0110","1001","1001","1001","0110"}
glyph["x"]={"1001","1001","0110","1001","1001"}
ramp={10,10,9,9,8}

function gat(g,rx,ry)
 if ry<1 or ry>5 or rx<1 or rx>4 then return false end
 return sub(g[ry],rx,rx)=="1"
end

-- c=nil draws the embossed art, otherwise a flat pass in colour c
function word(w,x0,y0,c)
 for i=1,#w do
  local g=glyph[sub(w,i,i)]
  local gx=x0+(i-1)*adv
  for ry=1,5 do
   for rx=1,4 do
    if gat(g,rx,ry) then
     local x,y=gx+(rx-1)*cs,y0+(ry-1)*cs
     local x2,y2=x+cs-1,y+cs-1
     if c then
      rectfill(x,y,x2,y2,c)
     else
      rectfill(x,y,x2,y2,ramp[ry])
      -- emboss the outer contour only: a lit edge per empty neighbour
      if not gat(g,rx,ry-1) then line(x,y,x2,y,7) end
      if not gat(g,rx-1,ry) then line(x,y,x,y2,7) end
      if not gat(g,rx,ry+1) then line(x,y2,x2,y2,4) end
      if not gat(g,rx+1,ry) then line(x2,y,x2,y2,4) end
     end
    end
   end
  end
 end
end

function title(w,x0,y0)
 -- drop shadow first: the black halo eats all but its outer edge.
 -- both are one cell, not a fixed 2px: at cs=3 a 2px halo closes in on a
 -- 2-cell hole from both sides and fills it, and the o goes solid
 word(w,x0+cs,y0+cs+1,2)
 for dx=-1,1 do
  for dy=-1,1 do
   word(w,x0+dx,y0+dy,0)
  end
 end
 word(w,x0,y0)
end
-->8
-- board pieces, 10px cells, drawn from scratch

-- rounded 1px corners, 1px colour-0 outline, dithered fill,
-- hi along top/left, global shadow ink 4 along bottom/right
function cell(x,y,base,dc,dens,hi,sz)
 sz=sz or 10
 local x2,y2=x+sz-1,y+sz-1
 rectfill(x+1,y,x2-1,y2,0)
 rectfill(x,y+1,x2,y2-1,0)
 fillp(dens)
 rectfill(x+1,y+1,x2-1,y2-1,base+dc*16)
 fillp()
 line(x+2,y+1,x2-2,y+1,hi)
 line(x+1,y+2,x+1,y2-2,hi)
 line(x+2,y2-1,x2-2,y2-1,4)
 line(x2-1,y+2,x2-1,y2-2,4)
end

-- the tail is the same cell one pixel in on every side, in the pink the
-- game gives it -- 8px against the body's 10, which is the 12-in-16 the
-- sprite uses. the cover has to show both ends or it is showing a rope
function tail(x,y)
 cell(x+1,y+1,14,8,dith_25,15,8)
end

function body(x,y)
 cell(x,y,11,3,dith_50,11)
end

function head(x,y)
 cell(x,y,10,9,dith_25,15)
 -- eyes look right, where the last step went
 rectfill(x+5,y+2,x+6,y+3,0) pset(x+5,y+2,7)
 rectfill(x+5,y+6,x+6,y+7,0) pset(x+5,y+6,7)
 -- tongue, reaching for the food one tile away
 line(x+10,y+4,x+12,y+4,8)
 pset(x+13,y+3,8) pset(x+13,y+5,8)
end

function food(x,y)
 local cx,cy=x+4,y+4
 circfill(cx,cy,4,0)
 fillp(dith_25)
 circfill(cx,cy,3,8+9*16)
 fillp()
 pset(cx-1,cy-1,10) pset(cx,cy-1,10) pset(cx-1,cy,10)
 pset(cx-1,cy-1,15)
end

function wall(x,y)
 cell(x,y,5,6,dith_25,6)
 line(x+1,y+4,x+8,y+4,0)
 line(x+4,y+1,x+4,y+3,0)
 line(x+6,y+5,x+6,y+8,0)
end

function door(x,y,letter)
 cell(x,y,13,12,dith_50,12)
 rect(x+2,y+2,x+7,y+7,1)
 fillp(dith_25)
 rectfill(x+3,y+3,x+6,y+6,1+12*16)
 fillp()
 if letter then oprint(letter,x+3,y+3,7) end
end
-->8
-- plates: three 6x6 floors, stacked up and to the right

function plate(px,py,base,dc,dens,grid,rim)
 rectfill(px+3,py+3,px+62,py+62,0)
 rectfill(px-1,py-1,px+60,py+60,0)
 fillp(dens)
 rectfill(px,py,px+59,py+59,base+dc*16)
 fillp()
 for i=1,5 do
  line(px+i*10-1,py,px+i*10-1,py+59,grid)
  line(px,py+i*10-1,px+59,py+i*10-1,grid)
 end
 -- a lit rim along the top and left edge lifts each plate off the one behind
 line(px,py,px+59,py,rim)
 line(px,py,px,py+59,rim)
end

-- background: black at the top fading to dark blue, with a soft glow
-- behind the stack so the plates sit in light
for y=0,127 do
 for x=0,127 do
  local dx,dy=x-72,y-64
  local k=1.15-sqrt(dx*dx+dy*dy)/78-y/300
  pset(x,y,dith(x,y,k) and 1 or 0)
 end
end

title("snakebox",9,4)

-- floor c, furthest back
plate(52,28,0,1,dith_50,1,5)
door(62,28,nil)
oprint("c",54,29,6)

-- floor b, middle: its body segments run behind floor a
plate(42,38,1,0,dith_25,2,6)
food(62,38)
for i=1,3 do body(92,38+i*10) end
oprint("b",44,39,6)

-- floor a, front: the floor you are looking at
plate(32,48,1,13,dith_25,2,6)
oprint("a",86,50,6)

function fx(gx) return 32+gx*10 end
function fy(gy) return 48+gy*10 end

door(fx(0),fy(0),"b")
wall(fx(3),fy(0))
wall(fx(0),fy(4))
food(fx(5),fy(4))
-- tail to neck, then the head
tail(fx(5),fy(2))
for s in all({{4,2},{3,2},{2,2},{1,2},{1,3},{1,4},{2,4}}) do
 body(fx(s[1]),fy(s[2]))
end
head(fx(3),fy(4))

-- bottom bar, same build as the game's
rectfill(0,113,127,127,5)
fillp(dith_50)
rectfill(0,114,127,115,5+0*16)
fillp()
line(0,113,127,113,0)
oprint("snakebox",5,116,7)
oprint("by roberto freire",5,122,6)
-->8
-- dump the screen as __label__ rows

printh("@@begin")
for y=0,127 do
 local s=""
 for x=0,127 do
  local c=pget(x,y)+1
  s=s..sub(hx,c,c)
 end
 printh(s)
end
printh("@@end")
extcmd("shutdown")
